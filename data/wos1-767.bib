Title = {Adaptive Learning in Computational Thinking: The Role of Emotional
   Feedback in Programming Contests Training},
Booktitle = {2025 IEEE GLOBAL ENGINEERING EDUCATION CONFERENCE, EDUCON},
Series = {IEEE Global Engineering Education Conference},
Year = {2025},
Note = {16th Global Engineering Education Conference-EDUCON-Annual, London,
   ENGLAND, APR 22-25, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {This paper presents the eLL-CMS system, an innovative tool designed to
   enhance pre-university students' programming skills while capturing
   their emotional states during the learning process. Building upon the
   existing Contest Management System (CMS), eLL-CMS integrates emotional
   feedback mechanisms to provide insights into students' affective states
   throughout problem-solving activities. The study examines programming
   contests, online judges, and the role of emotions in learning, while
   investigating methodologies for accurately measuring emotions during
   educational activities. A detailed description of the eLL-CMS tool,
   including its configuration, modifications, and validation process, is
   presented. By incorporating emotional data into programming contest
   training, eLL-CMS aims to optimize task selection based on students'
   emotional states, potentially enhancing educational outcomes through
   improved engagement and performance. This research makes a contribution
   to the field by demonstrating the potential of emotion-aware systems in
   improving the effectiveness of programming education and contest
   training for pre-university students.},
