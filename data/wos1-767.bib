   Gerosa, Marco A.},
Editor = {Folstad, A and Araujo, T and Papadopoulos, S and Law, ELC and Luger, E and Goodwin, M and Hobert, S and Brandtzaeg, PB},
Title = {Anticipating User Needs: Insights from Design Fiction on Conversational
   Agents for Computational Thinking},
Booktitle = {CHATBOT RESEARCH AND DESIGN, CONVERSATIONS 2023},
