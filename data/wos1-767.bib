@inproceedings{ WOS:001458245200014,
Author = {Torres, Nicolas and Olivares, Patricio},
Book-Group-Author = {IEEE},
Title = {Impact of an Interactive Learning Platform on Programming Student
   Outcomes: A Case Study of Teloprogramo},
Booktitle = {2024 43RD INTERNATIONAL CONFERENCE OF THE CHILEAN COMPUTER SCIENCE
   SOCIETY, SCCC},
Series = {Proceedings of the International Conference of the Chilean Computer
   Science Society},
Year = {2024},
Note = {43rd International Conference of the Chilean Computer Science Society,
   Universidad De La Frontera, Temuco, CHILE, OCT 28-30, 2024},
Abstract = {Teloprogramo is an innovative web platform that enhances programming
   education by leveraging artificial intelligence to improve student
   outcomes. Built on prior technological advancements and research, the
   platform offers auto-graded exercises for immediate feedback and
   integrates an AI model trained on introductory Python materials to
   assist with error detection and correction. A key feature is its
   gamified approach, where students earn points by solving exercises,
   which can be used to access AI-based help, fostering engagement.
   Teloprogramo also provides performance analytics, allowing students and
   instructors to track progress and refine learning strategies. Users can
   filter exercises by difficulty, review their attempt history, and tailor
   their learning. Pilot tests with university students and instructors
   have shown high success rates and a significant reduction in attempts
   per problem, demonstrating the platform's effectiveness. With AI-driven
   personalized feedback and adaptive learning, Teloprogramo offers a
   powerful solution to transform programming education.},
