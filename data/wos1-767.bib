@inproceedings{ WOS:000481890100081,
Author = {Harrington, Brian and Cheng, Nick},
Book-Group-Author = {Assoc Comp Machinery},
Title = {Tracing vs. Writing Code: Beyond the Learning Hierarchy},
Booktitle = {SIGCSE'18: PROCEEDINGS OF THE 49TH ACM TECHNICAL SYMPOSIUM ON COMPUTER
   SCIENCE EDUCATION},
Year = {2018},
Pages = {423-428},
Note = {49th ACM SIGCSE Technical Symposium on Computer Science Education
   (SIGCSE), Baltimore, MD, FEB 21-24, 2018},
Organization = {Assoc Comp Machinery; ACM Special Interest Grp Comp Sci Educ; GitHub;
   Google Inc; InfoSys Fdn; Intel; Microsoft; Vocareum Inc; Oracle Acad;
   IBM; Turings Craft Inc; ZyBooks; Codio; ABET; CodeHS; Gradescope; Mimir;
   Red Hat Acad},
Abstract = {Much work has been done on the achievement gap between code tracing and
   code writing in CS1 students. The generally accepted explanation for
   this gap is that tracing and writing form separate steps in a learning
   scaffolding; students must first learn to trace code before they can be
   expected to write code. The expectation is that once students have
   mastered these skills, future grades will be driven by their ability to
   understand the deeper learning concepts, and so the gap between tracing
   and writing should disappear.
   In this paper, we detail and evaluate a study on 384 CS2 students to
   evaluate whether a tracing-writing gap still exists, and assess whether
   anything can be deduced about students who continue to exhibit such a
   gap. We find that not only does the gap seem to have closed by CS2,
   students are equally likely to show a reverse gap in the writing-tracing
   direction. However, further analysis shows a strong correlation between
   students who do continue to have a gap (in either direction) and poor
   overall performance in the course.},
Publisher = {ASSOC COMPUTING MACHINERY},
Address = {1515 BROADWAY, NEW YORK, NY 10036-9998 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Harrington, B (Corresponding Author), Univ Toronto Scarborough, Dept Comp \& Math Sci, Scarborough, ON, Canada.
   Harrington, Brian; Cheng, Nick, Univ Toronto Scarborough, Dept Comp \& Math Sci, Scarborough, ON, Canada.},
DOI = {10.1145/3159450.3159530},
ISBN = {978-1-4503-5103-4},
Keywords = {Assessment; CS1; Computer Science Education; Code Tracing; Code Writing;
