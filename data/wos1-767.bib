@inproceedings{ WOS:001680177600052,
Author = {Skodova, Jarmila and Hynninen, Timo},
Editor = {ACM},
Title = {Evaluating AI Student's Performance in Programming MOOCs: Preliminary
   Study and Interactive Dashboard},
Booktitle = {PROCEEDINGS OF 25TH INTERNATIONAL CONFERENCE ON COMPUTING EDUCATION
   RESEARCH, KOLI CALLING 2025},
Year = {2025},
Note = {25th Koli Calling International Conference on Computing Education
   Research-Koli Calling, FINLAND, NOV 11-16, 2025},
Organization = {University of Eastern Finland; Aalto University; Instituto Federal de
   Brasilia; Joensuun yliopiston tukisaatio},
Abstract = {This work evaluated how well a large language model can solve
   programming exercises in online courses, presenting the results in the
   form of an interactive dashboard. We focused on seven free and public
   Finnish MOOCs in introductory programming. The dataset contained 741
   exercises in different programming languages. The OpenAI o1 model was
   asked to solve the tasks, and we recorded whether it succeeded. In
   total, the model solved 721 tasks, giving an overall success rate of
   97.3\%. Performance was consistent across Java and Python, and somewhat
   lower in Rust. While most exercises were solved easily, larger
   multi-step problems required repeated prompting or additional context.
   To visualize the findings and spark discussion, we created an
   interactive dashboard with several different views for the data. We
   suggest that such tools may help teachers, researchers, and students
   discuss how well AI ``synthetic students{''} perform in MOOCs, and
   reflect on how this affects the pedagogy.},
