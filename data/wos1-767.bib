@article{ WOS:001544842500003,
Author = {Yu, Hao and Chen, Yinxian and bin Ismail, Irwan Mahazir},
Title = {From scaffolding to success: How instructor pedagogical support and
   collaborative classroom interaction drive scholastic motivation in
   programming education},
Journal = {ACTA PSYCHOLOGICA},
Year = {2025},
Volume = {259},
Month = {SEP},
Abstract = {Educational institutions are increasingly exploring how teachers'
   personal qualities and technology use impact student motivation. This
   study examined whether teachers' pedagogical stewardship sense (a
   teacher's felt responsibility for guiding student learning) influences
   students' scholastic motivation, and whether this effect occurs through
   enhanced collaborative classroom interaction. We further assessed if
   AI-enhanced teaching integration (the extent to which instructors
   incorporate AI tools in teaching) moderates this process. Using a
   three-wave survey design in Chinese programming courses, we collected
   data at staggered intervals to reduce common method bias. The results
   indicated that teachers who exhibit a strong sense of pedagogical
   stewardship foster more collaborative interactions among students, which
   in turn is associated with higher student motivation. Notably, this
   indirect relationship was more pronounced when instructors highly
   integrated AI tools into their teaching. These findings suggest that
   supportive teacher attitudes coupled with thoughtful AI tool use can
   create a more interactive learning environment that energizes students'
   motivation. The study contributes to educational psychology and
   technology integration research by highlighting how teacher dispositions
   and AIfacilitated pedagogy jointly shape student engagement and
   motivation, offering practical insights for enhancing learning in the
   digital age.},
