@inproceedings{ WOS:001485244600050,
Author = {Canadas, Joaquin and Baron, Julio},
Editor = {Ruutmann, T and Auer, ME},
Title = {Designing Java Programming Exercises with AI Assistance in Introductory
   Courses},
Booktitle = {FUTUREPROOFING ENGINEERING EDUCATION FOR GLOBAL RESPONSIBILITY, ICL2024,
   VOL 3},
Series = {Lecture Notes in Networks and Systems},
Year = {2025},
Volume = {1280},
Pages = {538-546},
Note = {27th International Conference on Interactive Collaborative Learning-ICL,
   Tallinn, ESTONIA, SEP 24-27, 2024},
Abstract = {Generative artificial intelligence (AI) is revolutionizing many aspects
   of both academia and society. Its effective integration in computer
   science education is a current challenge for educators. This work
   presents an approach for using generative AI tools such as ChatGPT in
   teaching programming by enhancing programming exercises with AI
