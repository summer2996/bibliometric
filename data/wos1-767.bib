@inproceedings{ WOS:001443080400188,
Author = {Yeh, Thomas Y. and Tran, Karena and Gao, Ge and Yu, Tyler and Fong, Wai
   On and Chen, Tzu-Yi},
Book-Group-Author = {ACM},
Title = {Bridging Novice Programmers and LLMs with Interactivity},
Booktitle = {PROCEEDINGS OF THE 56TH ACM TECHNICAL SYMPOSIUM ON COMPUTER SCIENCE
   EDUCATION, SIGCSE TS 2025, VOL 1},
Year = {2025},
Pages = {1295-1301},
Note = {56th Technical Symposium on Computer Science Education, Pittsburgh, PA,
   FEB 26-MAR 01, 2025},
Abstract = {While Large Language Models (LLMs) enable experienced programmers to
   increase their productivity, LLMs' impact on learning and productivity
   for novices is currently unclear. Recent work showed novice programmers
   struggle with prompting LLMs for code generation and suggested that the
   use of LLMs in CS education could exacerbate existing equity issues.
   Educators are now faced with the difficult question of whether and when
   to incorporate the use of LLMs into the CS curriculum without adversely
   impacting student learning and equity. To address these concerns, we
   study the effects of using an interactive LLM on code generation with
   novice programmers. We find that using our interactive LLM improves the
   accuracy of code generation over the baseline LLM. Additionally, after
   using the interactive LLM, novices write improved prompts even when
   using the baseline LLM. Based on our findings, we plan to create iGPTs,
   a set of customized, interactive LLMs spanning CS education learning
   goals as templates to facilitate LLM integration for improving student
   learning and retention.},
