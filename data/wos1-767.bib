@inproceedings{ WOS:001181240800190,
Author = {Taylor, Andrew and Vassar, Alexandra and Renzella, Jake and Pearce,
   Hammond},
Book-Group-Author = {Assoc Computing Machinery},
Title = {dcc --help: Transforming the Role of the Compiler by Generating
   Context-Aware Error Explanations with Large Language Models},
Booktitle = {PROCEEDINGS OF THE 55TH ACM TECHNICAL SYMPOSIUM ON COMPUTER SCIENCE
   EDUCATION, SIGCSE 2024, VOL. 1},
Year = {2024},
Pages = {1314-1320},
Note = {55th Technical Symposium on Computer Science Education-SIGCSE TS,
   Portland, OR, MAR 20-23, 2024},
Organization = {Assoc Comp Machinery; ACM Special Interest Grp Comp Sci Educ;
   Association for Computing Machinery},
Abstract = {In the challenging field of introductory programming, high enrolments
   and failure rates drive us to explore tools and systems to enhance
   student outcomes, especially automated tools that scale to large
   cohorts. This paper presents and evaluates the dcc --help tool, an
   integration of a Large Language Model (LLM) into the Debugging C
   Compiler (DCC) to generate unique, novice-focused explanations tailored
   to each error. dcc --help prompts an LLM with contextual information of
   compile- and run-time error occurrences, including the source code,
   error location and standard compiler error message. The LLM is
   instructed to generate novice-focused, actionable error explanations and
   guidance, designed to help students understand and resolve problems
   without providing solutions. dcc --help was deployed to our CS1 and CS2
   courses, with 2,565 students using the tool over 64,000 times in ten
   weeks. We analysed a subset of these error/explanation pairs to evaluate
   their properties, including conceptual correctness, relevancy, and
   overall quality. We found that the LLM-generated explanations were
   conceptually accurate in 90\% of compile-time and 75\% of run-time
   cases, but often disregarded the instruction not to provide solutions in
   code. Our findings, observations and reflections following deployment
   indicate that dcc --help provides novel opportunities for scaffolding
   students' introduction to programming.},
