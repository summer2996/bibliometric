@inproceedings{ WOS:001670358000021,
Author = {Goehler, Volker},
Book-Group-Author = {ACM},
Title = {Critical or Confident? AI Literacy and Student-AI Collaboration in
   Higher Education},
Booktitle = {PROCEEDINGS OF THE 26TH ACM ANNUAL CONFERENCE ON CYBERSECURITY \&
   INFORMATION TECHNOLOGY EDUCATION, ACM SIGCITE 2025},
Year = {2025},
Pages = {119-126},
Note = {26th Annual Conference on Information Technology Education-SIGITE,
   Consumnes River College, Sacramento, CA, NOV 06-08, 2025},
Organization = {Jones \& Bartlett Learning LLC},
Abstract = {Large language models (LLMs) are rapidly transforming programming
   education, yet little is known about how students' AI literacy and
   skills shape human-AI collaboration. We conducted an exploratory study
   with 23 computer science and robotics students who completed
   discipline-specific programming tasks in which the LLM produced the code
   and students guided and debugged it. AI literacy, measured with the
   SNAIL instrument, was generally high, with Practical Application rated
   highest and Critical Appraisal lowest, suggesting a risk of
   overconfidence. No robust links emerged between AI literacy, programming
   skill, task duration, or perceived chatbot output quality. Qualitative
   feedback revealed both enthusiasm for experimentation and frustration
   with AI errors. Findings indicate that brief, well-structured tasks can
   support productive AI-student collaboration, but stronger emphasis on
   critical evaluation, domain-specific skills, and appropriate scaffolding
   is needed.},
