@inproceedings{ WOS:001722635800134,
Author = {Rebelsky, William},
Book-Group-Author = {ACM},
Title = {Talking to Our Students About Generative AI},
Booktitle = {PROCEEDINGS OF THE 57TH ACM TECHNICAL SYMPOSIUM ON COMPUTER SCIENCE
   EDUCATION V.1, SIGCSE TS 2026},
Year = {2026},
Pages = {915-921},
Note = {57th Technical Symposium on Computer Science Education-SIGCSE TS, St.
   Louis, MO, FEB 18-21, 2026},
Organization = {Association for Computing Machinery; Ireland ACM SIGCSE Chapter},
Abstract = {Generative Artificial Intelligence (GenAI), especially in the form of
   Large Language Models (LLMs), has been the subject of many papers both
   positive and negative. No matter the stance, it is clear that its
   existence has huge implications for education, and people are looking
   for advice on how to use it appropriately, if that is even possible. As
   Computer Science educators we have particular interests in GenAI,
   especially the ways in which CS students use and understand GenAI.
   Some uses will be similar; students may turn to GenAI to generate an
   idea or polish their writing. But the issues go beyond that; our
   students also utilize these tools in ways that may be different from
   students in other disciplines such as code development, algorithm
   design, and debugging. Evidence also suggests that computing students
   are both more likely to use GenAI tools and design and work on these
   systems in the future.
   As computing professionals, we have an additional obligation to form
   recommendations because we have the background and training to
   understand the underlying models, giving our words more weight to
   students and other educators. In this paper, we provide strategies and
   examples to help computing faculty talk to their students about GenAI
   and over-reliance on GenAI, grounding these strategies and suggestions
   in recent work on GenAI and GenAI in education.},
Publisher = {ASSOC COMPUTING MACHINERY},
