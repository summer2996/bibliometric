@inproceedings{ WOS:001547246200012,
Author = {Michael, Jahns and Uneputty, Primo Giancarlo and Enda, Reka Paska and
   Santoso, Harry Budi and Adianto, Daya and Cenka, Baginda Anggun Nan},
Book-Group-Author = {Schrepp, M},
Title = {Development and Evaluation of Scaffcode INC: A Game-Based Learning App
   for Teaching Basic Programming with Scaffolding},
Booktitle = {DESIGN, USER EXPERIENCE, AND USABILITY, DUXU 2025, PT IV},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {15797},
Pages = {168-186},
Note = {14th International Conference on Design User Experience and
   Usability-DUXU-Annual, Goeteborg, SWEDEN, JUN 22-27, 2025},
Abstract = {This study proposes Scaffcode INC, a game-based learning application
   designed to introduce basic programming concepts to high school students
   through the application of scaffolding techniques. The primary goal is
   to enhance student motivation and interest in pursuing computer science
   programs at the university level, addressing the anticipated demand for
   IT professionals in the Indonesian labor market. The research evaluates
   the application using the MEEGA + model, assessing students' perceptions
   of motivation, understanding, and experience while engaging with the
   game. Furthermore, Scaffcode INC is evaluated through playtesting
   utilizing the MEEGA + evaluation model. The results indicate that
   Scaffcode INC is categorized as a good-quality educational game based on
   the MEEGA + quality assessment guideline. However, opportunities exist
   to improve the user interface design and challenge difficulty level,
   enhancing the learning and gaming experience, as well as deepening the
   understanding of programming concepts. This serves as a proof of concept
   for integrating scaffolding techniques into game elements to teach
   programming concepts outside of a structured classroom.},
