@inproceedings{ WOS:001670358000019,
Author = {Jeswani, Sumeet and Mittal, Akshay and Sewlani, Soni},
Book-Group-Author = {ACM},
Title = {Premature Trust: How Student Overreliance on GenAI is Seeding Tomorrow's
   Security Gaps},
Booktitle = {PROCEEDINGS OF THE 26TH ACM ANNUAL CONFERENCE ON CYBERSECURITY \&
   INFORMATION TECHNOLOGY EDUCATION, ACM SIGCITE 2025},
Year = {2025},
Pages = {107-112},
Note = {26th Annual Conference on Information Technology Education-SIGITE,
   Consumnes River College, Sacramento, CA, NOV 06-08, 2025},
Organization = {Jones \& Bartlett Learning LLC},
Abstract = {The rapid proliferation of generative AI tools into educational software
   development has created new pedagogical challenges. While these tools
   offer productivity benefits and learning support, they may introduce
   security risks when students adopt AI-generated code without adequate
   verification or understanding of security implications.
   Through analysis of case studies and emerging educational patterns, we
   identify a concerning trend of ``premature trust{''} in AIassisted
   coding environments, where students accept AI outputs without sufficient
   critical evaluation. This phenomenon potentially threatens long-term
   software security as these students enter the professional workforce.
   This paper proposes FoSAC-Ed (Foundations of Secure AI Coding for
   Education), a pedagogical framework designed to cultivate security-aware
   AI coding practices in computer science education. The framework
   encompasses five core pillars: Early threat modeling, Secure prompt
   engineering, Code provenance awareness, Human-AI code review loops, and
   Embedded security feedback. We present the theoretical foundation,
   implementation guidance, and preliminary exploratory findings from a
   simulated pilot study.
   Important Note: The pilot study has significant methodological
   limitations and should be interpreted as initial exploration rather than
   conclusive validation. We outline comprehensive plans for rigorous
   empirical testing to establish the framework's effectiveness. This work
   aims to initiate discussion and collaboration toward developing
   evidence-based approaches for secure AI-assisted coding education.},
Publisher = {ASSOC COMPUTING MACHINERY},
Address = {1601 Broadway, 10th Floor, NEW YORK, NY, UNITED STATES},
