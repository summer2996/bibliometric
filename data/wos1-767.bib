@inproceedings{ WOS:001680177600056,
Author = {Mariescu-Istodor, Radu and Grohn, Anssi},
Editor = {ACM},
Title = {LEO: A Live Coding Assistant for Teachers},
Booktitle = {PROCEEDINGS OF 25TH INTERNATIONAL CONFERENCE ON COMPUTING EDUCATION
   RESEARCH, KOLI CALLING 2025},
Year = {2025},
Note = {25th Koli Calling International Conference on Computing Education
   Research-Koli Calling, FINLAND, NOV 11-16, 2025},
Organization = {University of Eastern Finland; Aalto University; Instituto Federal de
   Brasilia; Joensuun yliopiston tukisaatio},
Abstract = {Live coding is a powerful pedagogical technique in programming
   education, however, it is stressful for instructors, who must write code
   accurately while managing classroom dynamics. Unexpected errors and
   interruptions often derail sessions, reducing effectiveness and
   discouraging participation.
   We present LEO12, a lightweight open-source tool that automatically
   types pre-written lesson code character by character. LEO removes
   unexpected syntax/runtime errors, helps maintain a learner-friendly
   pace, and lets instructors focus on eye contact, explanations, and
   student engagement. It is also effective for creating educational videos
   and live streams, reducing recording stress and editing effort.
   We tested LEO in classrooms, YouTube tutorials, and live-streams.
   Results show LEO-assisted sessions run as planned and can produce more
   usable code, while helping to sustain more interaction than traditional
   approaches. By reducing cognitive load, LEO makes live coding more
   accessible, allowing educators to shift their role from code production
   to guidance and motivation.},
