@inproceedings{ WOS:000468494200054,
Author = {Harsley, Rachel and Fossati, Davide and Di Eugenio, Barbara and Green,
   Nick},
Book-Group-Author = {ACM},
Title = {Interactions of Individual and Pair Programmers with an Intelligent
   Tutoring System for Computer Science},
Booktitle = {PROCEEDINGS OF THE 2017 ACM SIGCSE TECHNICAL SYMPOSIUM ON COMPUTER
   SCIENCE EDUCATION (SIGCSE'17)},
Year = {2017},
Pages = {285-290},
Note = {ACM SIGCSE Technical Symposium on Computer Science Education (SIGCSE),
   Seattle, WA, MAR 08-11, 2017},
Organization = {Assoc Comp Machinery; ACM Special Interest Grp Comp Sci Educ},
Abstract = {Pair programming is a practice where two coders work side by side at one
   computer. The practice has been linked to many benefits including
   increased student engagement, satisfaction, and course grades. We
   present a quantitative study comparing the fine-grained interactions of
   individual programmers versus pair programmers as they work to solve
   coding problems using an Intelligent Tutoring System. We collected data
   from over 115 students resulting in more than 53,000 log events. We
   discovered that while both individual and pair programmers had
   equivalent learning gains, pair programmers took significantly less time
   on most problems, consulted fewer examples, coded more efficiently, and
   showed more signs of engagement. Individuals adapted to problems
   requiring new and compounded concepts at a rate similar to pair
   programmers.},
