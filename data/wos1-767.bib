@article{ WOS:001647607500001,
Author = {Akcay, Arif and Avan, Cagri and Karabulut Coskun, Burcu},
Title = {You're not alone while programming! Challenges faced by high school
   students, generative AI solutions and issues},
Journal = {INTERACTIVE LEARNING ENVIRONMENTS},
Year = {2025},
Month = {2025 DEC 25},
Abstract = {Programming is a challenging yet crucial component of technological
   literacy. It contains inherent difficulties that may lead students to
   drop out. The unique features of Generative Artificial Intelligence
   (GenAI) can influence how programming is learned. This study aims to
   identify the challenges, solutions, and requirements encountered by high
   school students in learning programming and examine their experiences
   with using GenAI during this process. The study utilizes a case study
   design. Interviews were conducted with 19 students representing a range
   of academic achievement levels. The researchers identified codes,
   sub-themes, and themes based on the collected data. In the findings,
   students expressed that they had difficulty with debugging, coding, and
   algorithm development, and that they sought information, practiced, and
   used different learning approaches to overcome these difficulties.
   Students said that they use GenAI for purposes such as debugging,
   coding, and generating information. They expressed concerns that GenAI
   could create systemic, social, and individual problems during this
   process. In conclusion, students face difficulties while learning
   programming, and they can utilize GenAI to address these challenges;
   however, this approach can also lead to some issues. The study provides
   recommendations to ensure the conscious use of this technology in
   programming education.},
