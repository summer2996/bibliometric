@inproceedings{ WOS:001722635800019,
Author = {Bell, Jacob and Deschamps, Anna and Kapoor, Eva and Karki, Salyan and
   Kim, Julian and Gonzalez, Nicole Moreno and Pitchford, William and
   Sturua, Elene and Wade, Charles and Rebelsky, Samuel A.},
Book-Group-Author = {ACM},
Title = {An Innovative Approach to Parsons Problems for Teaching and Learning
   Functional Programming},
Booktitle = {PROCEEDINGS OF THE 57TH ACM TECHNICAL SYMPOSIUM ON COMPUTER SCIENCE
   EDUCATION V.1, SIGCSE TS 2026},
Year = {2026},
Pages = {114-120},
Note = {57th Technical Symposium on Computer Science Education-SIGCSE TS, St.
   Louis, MO, FEB 18-21, 2026},
Organization = {Association for Computing Machinery; Ireland ACM SIGCSE Chapter},
Abstract = {Programming exercises are central to learning. Parsons Problems (PPs)
   ask students to arrange shuffled code blocks into correct order,
   emphasizing logic over syntax and enabling efficient assessment.
   Furthermore, by focusing on mastering logic rather than syntax, PPs
   reduce students' cognitive load and provide a more direct mechanism for
   assessing students.
   However, most PPs and environments for building PPs emphasize a
   sequential model, where code chunks primarily revolve around line-based
   programming. What if we want students to master other kinds of
   sequencing? For example, most modern languages and frameworks now
   support functional programming, a model in which sequencing is often
   achieved by nesting expressions rather than ordering statements. In
   addition, functional approaches also permit higher-order operations-such
   as mapping, filtering, and reducing-in which the programmer may best
   understand the work as being done in parallel. Can we reframe PPs to
   teach such concepts?
   We address these problems by introducing Nested-Block PPs, composed of
   blocks in which students drag and drop subexpressions into other
   expressions. We then show the utility of this approach in developing
   functional programming problems. Our system also includes a code
   executor that can generate output and provide error messages, which
   permits students to receive real-time feedback.
   Finally, we implement a method to generate problems based on pre-written
   template solutions. The Nested-Block approach suggests a new path for
   Parsons Problems, opening new pedagogical territory while retaining
   accessibility and efficiency.},
Publisher = {ASSOC COMPUTING MACHINERY},
Address = {1601 Broadway, 10th Floor, NEW YORK, NY, UNITED STATES},
