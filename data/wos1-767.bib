@inproceedings{ WOS:001117817800069,
Author = {Schmellenkamp, Marko and Latys, Alexandra and Zeume, Thomas},
Book-Group-Author = {ACM},
Title = {Discovering and Quantifying Misconceptions in Formal Methods Using
   Intelligent Tutoring Systems},
Booktitle = {PROCEEDINGS OF THE 54TH ACM TECHNICAL SYMPOSIUM ON COMPUTER SCIENCE
   EDUCATION, VOL 1, SIGCSE 2023},
Year = {2023},
Pages = {465-471},
Note = {54th Annual ACM SIGCSE Technical Symposium on Computer Science Education
   (SIGCSE TS), Toronto, CANADA, MAR 15-18, 2023},
Organization = {Assoc Comp Machinery; ACM Special Interest Grp Comp Sci Educ},
Abstract = {In this paper we advocate the study of misconceptions in the formal
   methods domain by integrating quantitative and qualitative methods. In
   this domain, so far, misconceptions have mostly been studied with
   qualitative methods, typically via interviews with less than 20
   subjects. We discuss workflows for (1) determining the commonness of
   qualitatively established misconceptions by quantitative means; and for
   (2) the initial discovery of misconceptions by quantitative methods
   followed by qualitative assessments.
   Parts of these workflows are then applied to a data set for exercises on
   logical modeling from the intelligent tutoring system ILTIS with > 250
   data points for many of the exercises. We analyze the data in order to
   (1) determine the commonness of qualitatively-identified misconceptions
   on modeling in propositional logic; and to (2) discover typical mistakes
   in modeling in propositional logic, modal logic, and first-order logic.},
