Title = {Teaching Computational Thinking Through Active Games: Insights from
   Teacher Training},
Booktitle = {INFORMATICS IN SCHOOLS. FOSTERING PROBLEM-SOLVING, CREATIVITY, AND
   CRITICAL THINKING THROUGH COMPUTER SCIENCE EDUCATION, ISSEP 2025},
Series = {Lecture Notes in Computer Science},
