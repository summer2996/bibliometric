@inproceedings{ WOS:001540559800074,
Author = {Bahrami, Shaghayegh and Karimi, Ouldooz Baghban},
Book-Group-Author = {ACM},
Title = {Scaffolding and Risk-Taking in Project-Based Learning},
Booktitle = {PROCEEDINGS OF THE 30TH ACM CONFERENCE ON INNOVATION AND TECHNOLOGY IN
   COMPUTER SCIENCE EDUCATION VOL 2, ITICSE 2025},
Year = {2025},
Pages = {798},
Note = {30th Conference on Innovation and Technology in Computer Science
   Education-ITICSE-Annual, Nijmegen, NETHERLANDS, JUN 27-JUL 02, 2025},
Organization = {Association for Computing Machinery; SIGCSE},
Abstract = {In addition to achieving learning outcomes, project-based learning (PBL)
   in groups is known to foster communications, team building,
   collaboration, and leadership skills, all essential for computer
   scientists in the workforce. Academic risk-taking, enabling students to
   attempt more complex problems and challenging projects, is a valuable
   skill for high academic achievement {[}7], making it a desirable skill
   for students in a fast-paced discipline. To explore the possibility of
   fostering academic risk-taking in PBL as a valuable skill for computer
   scientists, we focused on the impact of scaffolding to improve the PBL
   outcomes for diverse learners and its impact on risk-taking. We report
   on our initial findings and navigating grade-related risks, incentives,
   and timing constraints.},
