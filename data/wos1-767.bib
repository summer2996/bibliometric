@inproceedings{ WOS:001562419800015,
Author = {Cuellar Argotty, Juan Esteban and Manrique, Ruben},
Editor = {Graf, S and Markos, A},
Title = {AI-Generated Code Detection: An Examination of Current Tools in
   Education},
Booktitle = {GENERATIVE SYSTEMS AND INTELLIGENT TUTORING SYSTEMS, ITS 2025, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2026},
Volume = {15723},
Pages = {192-201},
Note = {21st International Conference on Intelligent Tutoring
   Systems-ITS-Annual, GREECE, JUN 03-06, 2025},
Organization = {Democritus University of Thrace},
Abstract = {The increasing availability of large language models (LLMs) has raised
   significant concerns over academic integrity in introductory programming
   courses. Existing AI detectors, primarily developed for natural
   language, have shown limited efficacy when identifying AI-generated
   code, particularly after simple obfuscations. This study evaluates seven
   state-of-the-art detection tools on Python solutions collected from an
   educational platform (Senecode). We built a new dataset of 822
   human-written and 822 AI-generated code samples, with the AI samples
   systematically modified using six prompt variants. Our findings reveal
   critical precision-recall tradeoffs and notable performance drops in the
   face of minor obfuscation. Our findings reveal that current AI-detection
   tools are unreliable for educational use and highlight the need to shift
   focus toward rethinking assessment practices in the age of generative
   AI.},
