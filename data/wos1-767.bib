Title = {The Effect of Emotional Scaffolding on Vocational School Students'
   Emotions and Self-efficacy in Programming Learning},
Booktitle = {2025 11TH INTERNATIONAL CONFERENCE ON EDUCATION AND TRAINING
   TECHNOLOGIES, ICETT},
Year = {2025},
Pages = {312-317},
Note = {11th International Conference on Education and Training
   Technologies-ICETT, Macau, PEOPLES R CHINA, MAY 23-25, 2025},
Organization = {Association for Computing Machinery; Beijing Spring Institute of
   Education},
Abstract = {At a time when vocational education is highly emphasized and programming
   education is becoming more and more critical, vocational school students
   face many challenges in programming learning, and emotional factors have
   a significant impact on their learning effects. The sample consisted of
   34 students in the Big Data 1 class 2023 in a vocational school in
   Shenzhen. In this study, prior knowledge and cognitive style were used
   as independent variables to investigate the effects of emotional
   scaffolding on vocational school students' programming learning emotions
   and self-efficacy. The results of the study showed that: (1) emotional
   scaffolding could significantly enhance students' momentary enjoyment,
   but had a limited effect on anxiety and boredom; (2) emotional
   scaffolding had a nonsignificant effect on self-efficacy; (3) changes in
   enjoyment in the classroom had a significant positive effect on
   self-efficacy, while anxiety and boredom had a non-significant effect on
   self-efficacy.},
