Author = {Szabo, Claudia and Falkner, Nickolas and Petersen, Andrew and Bort,
   Heather and Cunningham, Kathryn and Donaldson, Peter and Hellas, Arto
   and Robinson, James and Sheard, Judy},
Book-Group-Author = {ACM},
Title = {Review and Use of Learning Theories within Computer Science Education
   Research: Primer for Researchers and Practitioners},
Booktitle = {PROCEEDINGS OF THE WORKING GROUP REPORTS ON INNOVATION AND TECHNOLOGY IN
   COMPUTER SCIENCE EDUCATION (ITICSE-WGR `19)},
Year = {2019},
Pages = {89-109},
Note = {24th ACM Working Group Reports Annual Conference on Innovation and
