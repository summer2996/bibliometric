@inproceedings{ WOS:001325262600014,
Author = {Jacobs, Sven and Jaschke, Steffen},
Editor = {Bollin, A and Bosnic, I and Brings, J and Daun, M and Manjunath, M},
Title = {Leveraging Lecture Content for Improved Feedback: Explorations with
