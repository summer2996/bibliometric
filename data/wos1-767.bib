@article{ WOS:001607520200001,
Author = {Khor, Ean Teng and Chan, Leta and Koh, Elizabeth and Seow, Peter},
Title = {Exploring students' perceptions of generative AI-generated feedback in
   learning programming},
Journal = {EDUCATIONAL PSYCHOLOGY},
Year = {2026},
Volume = {46},
Number = {1, SI},
Pages = {150-182},
Month = {JAN 2},
Abstract = {Generative Artificial Intelligence (GenAI) has gained popularity in
   various sectors including the education sector, becoming more advanced
   and widespread. While teachers and institutions may be keen to employ
   this new technology, whether students share this enthusiasm ultimately
   determines its success in facilitating learning. Therefore, this paper
   seeks to understand 15-16-year-old computing students' perception of
   using a GenAI Chatbot through the theoretical lens of an adapted
   Technology Acceptance Model. Singapore secondary school students were
   surveyed on their perceptions on completing a computing task with a
   GenAI Chatbot. The findings revealed that students perceived the ease of
   use and usefulness of GenAI positively, which were predicted by their
   enjoyment and preparation to use GenAI, and their perceived ease of use
   respectively. Students' intentions to use GenAI were also predicted by
   subjective norms endorsing its use and their perceived usefulness of the
   chatbot. Implications for AI in education are discussed.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
