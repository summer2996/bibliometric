Author = {Maestro-Prieto, Jose A. and Simon-Hurtado, Arancha},
Editor = {Polycarpou, I and Read, JC and Andreou, P and Armoni, M},
Title = {The Pedagogical Model of SIAL: An Adaptive and Open-Ended Intelligent
   Tutoring System for First Order Logic},
Booktitle = {ITICSE'18: PROCEEDINGS OF THE 23RD ANNUAL ACM CONFERENCE ON INNOVATION
   AND TECHNOLOGY IN COMPUTER SCIENCE EDUCATION},
Year = {2018},
Pages = {21-26},
