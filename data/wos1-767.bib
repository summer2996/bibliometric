@article{ WOS:001629936100001,
Author = {Dong, Wei and Zhao, Fangxuan and Yu, Nengbao and Zhang, Quan},
Title = {Is there a difference in cognition and behavior among learners with
   different learning styles when using GenAI-assisted learning? An
   empirical analysis based on programming learning},
Journal = {INTERACTIVE LEARNING ENVIRONMENTS},
Year = {2025},
Month = {2025 DEC 5},
Abstract = {With the advancement of generative AI (GenAI), its integration into
   education is gaining attention. Investigating the cognitive and
   behavioral differences of learners with different learning styles during
   the collaborative programming process with GenAI can promote the
   intelligent transformation of educational models and personalized
   teaching. This study focuses on programming learning, establishes a
   programming learning model supported by GenAI, and conducts experiments
   based on this model to test the effectiveness of GenAI-assisted
   programming education and analyze the cognitive and behavioral
   differences of learners with different learning styles when using GenAI.
   The research found: (1) Collaborative programming with GenAI improves
   learners' academic performance and programming efficiency; (2) The
   cognitive network differences of learners with different learning styles
   in human-computer collaborative programming are insignificant; (3)
   Overall behavior sequence analysis shows that learners exhibit a typical
   behavioral pattern centered on ``asking-verifying-correcting{''} during
   the collaborative programming process with GenAI; (4) There are
   differences in the behavior sequences of learners with different
   learning styles in human-computer collaborative programming. Therefore,
   teachers understand the behavioral differences to design precise
   personalized plans and foster effective questioning strategies for
   better use of GenAI tools.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article; Early Access},
Language = {English},
Affiliation = {Zhao, FX (Corresponding Author), Tianjin Univ, Sch Educ, Tianjin, Peoples R China.
   Dong, Wei; Zhao, Fangxuan; Zhang, Quan, Tianjin Univ, Sch Educ, Tianjin, Peoples R China.
   Yu, Nengbao, Tiangong Univ, Sch Humanities, Tianjin, Peoples R China.},
DOI = {10.1080/10494820.2025.2589404},
EarlyAccessDate = {DEC 2025},
