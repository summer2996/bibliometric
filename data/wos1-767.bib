@inproceedings{ WOS:001119104600014,
Author = {Sundin, Lovisa and Sakr, Nourhan and Leinonen, Juho and Aly, Sherif and
   Cutts, Quintin},
Book-Group-Author = {Assoc Computing Machinery},
Title = {Visual recipes for slicing and dicing data: teaching data wrangling
   using subgoal graphics},
Booktitle = {PROCEEDINGS OF 21ST KOLI CALLING CONFERENCE ON COMPUTING EDUCATION
   RESEARCH, KOLI CALLING 2021,},
Year = {2021},
Note = {21st Koli Calling Conference on Computing Education Research (Koli
   Calling), ELECTR NETWORK, NOV 18-21, 2021},
Organization = {Aalto Univ; Univ Toronto Mississauga; Univ Eastern Finland},
Abstract = {The rising demand for data wrangling skills in today's global market
   poses new challenges for the programming education community. Non-majors
   often need to learn it quickly alongside their other subjects. Previous
   research suggests that subgoal labels offer a powerful scaffolding
   strategy to help novices decompose problems. Because data wrangling is
   inherently easy to represent graphically, we wonder whether such labels
   could be augmented with subgoal graphics. To test this idea, we
   developed an online tutorial that features subgoal graphics in both
   programmatic and non-programmatic data wrangling exercises. Following an
   RCT paradigm, a control group is only given subgoal labels, without any
   graphics. The platform collects learner activity in order to evaluate
   the pedagogical benefits. Participants were recruited from multiple
   institutions (N=197, 134). Our results did not show a significant
   difference in various learner performance metrics, however subjective
   feedback from our participants suggest that learners perceive the
   graphics to be very helpful. We discuss possible reasons for the
   apparent disparity between objective and subjective data.},
