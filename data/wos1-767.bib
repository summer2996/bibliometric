@inproceedings{ WOS:001713417800003,
Author = {Pedro, Leonardo and Velazquez-Iturbide, J. Angel and Paredes-Velasco,
   Maximiliano and Palacios-Alonso, Daniel},
Editor = {Gomes, CA and Pereira, I and Conde, MA and Morais, NS},
Title = {The Emotional Experience of Learning Programming through Scratch in
   Angolan Technical and Vocational Education},
Booktitle = {2025 INTERNATIONAL SYMPOSIUM ON COMPUTERS IN EDUCATION, SIIE},
Series = {International Symposium on Computers in Education},
Year = {2025},
Note = {2025 International Symposium on Computers in Education-SIIE, Viseu,
   PORTUGAL, NOV 20-22, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {This study investigates the emotional impact of different teaching
   methodologies in programming education for 10th-grade students at a
   technical secondary school in Angola. Over two academic years, 221
   students were observed. The traditional method, based on pseudocode and
   flowcharts, was compared with the use of Scratch, a block- based
   programming language introduced in 2024/25. Data were collected through
   the Portuguese version of the PANAS scale. Results indicate that Scratch
   fosters positive emotions and reduces negative ones, supporting the
   hypothesis that this approach enhances students' emotional experience
   and may contribute to improved learning outcomes in programming.},
