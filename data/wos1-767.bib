@inproceedings{ WOS:001427131200038,
Author = {Boulden, Danielle and Smith, Andy and Cully, Kimkinyona and Houchins,
   Jennifer and Elsayed, Rasha and Cheuoua, Aleata Hubbard and Minogue,
   James and Oliver, Kevin and Ringstaff, Cathy and Mott, Bradford},
Book-Group-Author = {ACM},
Title = {Promoting Computational Thinking in Elementary School: A
   Narrative-Centered Learning Approach},
Booktitle = {PROCEEDINGS OF THE 26TH ACM CONFERENCE ON INNOVATION AND TECHNOLOGY IN
   COMPUTER SCIENCE EDUCATION, ITICSE 2021, VOL 2},
Year = {2021},
Pages = {655},
Note = {26th Conference on Innovation and Technology in Computer Science
   Education, GERMANY, JUN 26-JUL 01, 2021},
Abstract = {One of the most efficient ways for elementary school students to gain
   exposure to computational thinking is when it is integrated into other
   disciplinary areas; however, elementary school teachers often lack the
   necessary resources to do this effectively. By leveraging the motivation
   force of narrative to engage students and the scaffolding affordances of
   block-based programming to support students, computationally-rich
   narrative-centered learning offers promise to address this need. In this
   work, we review design principles from prior work for engaging
   elementary students in computational thinking as well as results from
   initial pilot studies to investigate how computationally-rich
   narrative-centered learning in the context of science problem solving
   can support the integration of computational thinking into other
   disciplinary areas.},
