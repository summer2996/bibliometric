@inproceedings{ WOS:001711513200089,
Author = {Mishra, Satanshu and Mohamed, Abdallah and Mohamed, Mostafa},
Book-Group-Author = {IEEE},
Title = {Towards Efficient Assessment: Personalized Quizzing Through Machine
   Learning},
Booktitle = {2025 IEEE CANADIAN CONFERENCE ON ELECTRICAL AND COMPUTER ENGINEERING,
   CCECE},
Series = {Canadian Conference on Electrical and Computer Engineering},
Year = {2025},
Pages = {469-474},
Note = {2025 Canadian Conference on Electrical and Computer
   Engineering-CCECE-Annual, Vancouver, CANADA, MAY 26-29, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {This paper explores the application of Machine Learning (ML) and Item
   Response Theory (IRT) to develop an adaptive learning framework for
   personalized quizzes in programming education. With the increasing
   demand for computing skills across diverse fields, the proposed system
   dynamically tailors questions to individual student abilities and
   learning styles. By continuously evaluating student performance, the
   system refines question types and difficulty levels to ensure a
   customized learning experience. Additionally, the system uses a mastery
   tracking mechanism to monitor student proficiency across topics and
   categories, enabling targeted learning interventions. To validate this
   approach, we implemented uLearn, an online e-learning system, and
   conducted an exploratory study. Results demonstrated improved student
   performance, enhanced comprehension, increased engagement, and a strong
   preference to continue using adaptive learning in the future.},
