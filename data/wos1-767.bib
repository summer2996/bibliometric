Title = {Parsons Problems to Scaffold CodeWriting: Impact on Performance and
   Problem-Solving Efficiency},
Booktitle = {PROCEEDINGS OF THE 2023 CONFERENCE ON INNOVATION AND TECHNOLOGY IN
   COMPUTER SCIENCE EDUCATION, ITICSE 2023, VOL. 2},
Year = {2023},
Pages = {665},
Note = {28th Annual Conference on Innovation and Technology in Computer Science
   Education (ITiCSE), Univ Turku, Turku, FINLAND, JUL 08-12, 2023},
Organization = {Assoc Comp Machinery; ACM Special Interest Grp Comp Sci Educ; ACM Europe
   Council; Informat Europe},
Abstract = {Novice programmers struggle with writing code from scratch. One possible
   way to help them is by using an equivalent Parsons problem on demand,
   where learners place mixed-up code blocks in the correct order. In a
   classroom study with 89 undergraduate students, we examined how using a
   Parsons problem as scaffolding impacts performance and problem-solving
   efficiency. Results showed that students in the Parsons as Help group
   achieved significantly higher practice performance and problem-solving
   efficiency than students who wrote code without help, while achieving
   the same level of posttest scores. These results improve the
   understanding of Parsons problems and contribute to the design of future
   coding practices.},
