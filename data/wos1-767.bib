@inproceedings{ WOS:000390607200020,
Author = {Ericson, Barbara and Rogers, Kantwon and Parker, Miranda and Morrison,
   Briana and Guzdial, Mark},
Book-Group-Author = {ACM},
Title = {Identifying Design Principles for CS Teacher Ebooks through Design-Based
