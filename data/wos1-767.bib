@inproceedings{ WOS:001713417800022,
Author = {de Araujo, Adorilson Bezerra and Mendes, Antonio Jose and Gil Fonseca,
   Nuno Miguel},
Editor = {Gomes, CA and Pereira, I and Conde, MA and Morais, NS},
Title = {S2SM-Scaffolded 2-Spiral Model for Programming Learning},
Booktitle = {2025 INTERNATIONAL SYMPOSIUM ON COMPUTERS IN EDUCATION, SIIE},
Series = {International Symposium on Computers in Education},
Year = {2025},
Note = {2025 International Symposium on Computers in Education-SIIE, Viseu,
   PORTUGAL, NOV 20-22, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {This paper presents the evolution of the Scaffolded 2-Spiral Model
   (S2SM) for Programming Learning across two Design-Based Research cycles.
   The S2SM is a pedagogical framework that supports progressive
   programming learning through structured scaffolding. It comprises two
   spirals: in the first, students alternate between block-based and
   text-based programming, enabling a gradual and supported transition from
   visual to textual coding; in the second, they focus exclusively on
   textual programming to deepen conceptual understanding and programming
   fluency. Building on previous conceptual work, this study details the
   model's pedagogical foundations-grounded in Use-Modify-Create and
   Predict-Run-Investigate-Modify-Make strategies-and its implementation
   through a hybrid curriculum that combines Code.org activities with
   Python's turtle module and Free Python Games. Evidence from both
   Design-Based Research's cycles suggests that block-based activities
   facilitated the transition to textual coding, reduced frustration, and
   fostered engagement and motivation. These findings reinforce the
   potential of the S2SM as a promising pedagogical approach for
   introductory programming education in high schools.},
