@INPROCEEDINGS{11488826,
author={Zhanatayev, Orazbek and Manbay, Shakhnazar-Sultan and Tolebay, Baglan and Serek, Azamat},
booktitle={2026 18th International Conference on Electronics, Computer, and Computation (ICECCO)}, 
title={Design and Evaluation of a Google Earth Engine-Based Training Framework for Water Resource Analysis in Educational Settings}, 
year={2026},
volume={},
number={},
pages={1-7},
abstract={This study will outline the establishment and evaluation of a training module based on Google Earth Engine (GEE) as a simple learning data analytics tool. The suggested framework will be based on a three-part pedagogical model that involves (i) conceptual backgrounds of remote sensing and hydrological processes, (ii) analytical experiences through Google Earth Engine capabilities of image collections, reducers, time-series analysis, spectral indices (NDWI, MNDWI), and (iii) application-based projects where the learners will be expected to study realworld water systems independently. A pilot group comprising 22 geography, computer science and environmental science students were provided with a threesession program, which included the basics of remote sensing, GEE based water resource analysis and the utility of the Normalized Difference Water Index (NDWI) to detect surface water. All the course participants completed the course and carried out their own research projects with openaccess datasets in GEE. This indicated the ease and flexibility of the framework. The test result increased significantly, $58.6 \%(S D=12.4)$ to $86.3 \%(S D=8.9)(p<0.01)$. The accuracy of water masks constructed by participants, when compared to the reference JRC Global Surface Water dataset, was 91.7 %, with a Kappa coefficient of 0.88. The time to complete a task reduced by 27 percent and the usefulness, clarity, and overall experience average ratings stood at 4.7, 4.6 and 4.8 respectively. While most participants improved their coding and data processing skills, 14 % initially encountered difficulties with JavaScript syntax. This highlights the need for introductory programming support in future iterations of the framework. The framework is effective in enhancing the analytical skills and understanding hydrological systems. It provides a resource-saving model of teaching environmental data that is easy to expand especially in schools which do not possess many computers. Programming assistance should be provided to beginners that is specific in future versions.},
keywords={Earth Observing System;Landsat;Sentinel-2;Payloads;MODIS;Filtering;Feedback;Filters;Circuits;Circuits and systems;Google Earth Engine;Remote Sensing;Water Resource Analysis;Environmental Data Analysis;CloudBased Geospatial Education},
