@INPROCEEDINGS{11328648,
author={Lubarda, Marko V. and Lubarda, Vlado A. and Schurgers, Curt and Phan, Alex and Baghdadchi, Saharnaz and Qi, Huihui},
booktitle={2025 IEEE Frontiers in Education Conference (FIE)}, 
title={Permitting GenAI Use on Assessments in an Introductory Programming Course}, 
year={2025},
volume={},
number={},
pages={1-5},
abstract={This innovative-practice work-in-progress paper investigates the feasibility and implications of permitting generative AI (GenAI) tools—such as ChatGPT, Gemini, and GitHub Copilot—on high-stakes assessments in an introductory computer programming course for engineers. Instruction on AI-assisted programming and metacognitive strategies was integrated into lectures to foster engagement with AI technology, critical thinking, and self-regulated learning. This was followed by a three-week group project and a final exam during which GenAI use was permitted. The assessments were designed to target higher-order cognitive skills such as application, analysis, synthesis, and evaluation. Student performance data was analyzed along with the results of a post-course survey evaluating students' perceptions about the course. The findings support the case for less restrictive assessment strategies in the age of AI, while also highlighting the challenges of designing AI-integrated courses and assessments that balance pedagogical goals, academic integrity, and equity.},
keywords={Surveys;Generative AI;Chatbots;Programming profession;Software development management;academic integrity;AI-assisted programming;AI literacy;authentic assessment;programming education},
