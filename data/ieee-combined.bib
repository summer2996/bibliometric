@INPROCEEDINGS{11425138,
author={Senjaya, Wenny Franciska and Nathasya, Rossevine Artha and Liliawati, Swat Lie and Karnalim, Oscar and Vivaldy, Tristan and Arsito, Jerry Livano},
booktitle={2025 13th International Conference on Orange Technology (ICOT)}, 
title={Outsmarting Disguises: Evaluating SSTRANGE for Plagiarism Detection in Computer Graphics Code}, 
year={2025},
volume={},
number={},
pages={1-4},
abstract={Source code plagiarism remains a critical issue in programming education, with students increasingly altering copied code to evade detection. This study investigates the effectiveness of SSTRANGE, a similarity detection tool utilizing locality-sensitive hashing, in identifying plagiarized JavaScript code within computer graphics assignments. Specifically, we address the following research questions: (1) What disguise methods do students employ in computer graphics assessments? and (2) How effective is SSTRANGE in detecting these disguised works? We analyzed submissions from a computer graphics course, comparing original assignments from 21 students with disguised versions created by an additional 20 participants to mimic real-world plagiarism. Our analysis identified common disguise methods, including syntax changes, variable renaming, and structural alterations. Evaluation of SSTRANGE's detection performance using top-1 precision revealed an effectiveness of 59%, indicating that the tool correctly matched copied programs to their originals in just over half of the cases. The moderate performance of SSTRANGE suggests that while it shows promise for plagiarism detection, further refinement is needed to effectively counteract the disguise methods prevalent in computer graphics assignments.},
keywords={Codes;Plagiarism;Source coding;Education;Computer graphics;Syntactics;Social implications of technology;Programming profession;Plagiarism detection;computer graphics;SSTRANGE;academic integrity;code similarity;programming education},
