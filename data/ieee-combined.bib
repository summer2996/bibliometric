month={June},
journal={2023 IEEE 47th Annual Computers, Software, and Applications Conference (COMPSAC)},
author_keywords={Codes;Social networking (online);Debugging;Chatbots;Software;Task analysis;Interviews;ChatGPT;Coding Generation;Software Engineering;Large Language Models (LLMs);Generative Models;Social Media},
affiliation={},
