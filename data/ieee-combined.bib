@INPROCEEDINGS{11226690,
author={Liu, Weiwan},
booktitle={2025 International Conference on Computers, Information Processing and Advanced Education (CIPAE)}, 
title={Research on Recommendation Algorithm for Teaching Resources of Programming Courses Empowered by Knowledge Graph}, 
year={2025},
volume={},
number={},
pages={450-456},
abstract={This study is dedicated to developing a recommendation algorithm for teaching resources of programming courses empowered by knowledge graph, so as to overcome the problem that the existing recommendation method has low accuracy and cannot meet the dynamic learning needs of students. The algorithm constructs a knowledge graph that includes core knowledge such as programming language syntax, algorithm design, and programming framework, and innovatively uses the knowledge representation learning method based on the improved architecture of graph neural network to strengthen the semantic analysis and feature extraction of programming knowledge. By deeply associating students' learning behavior data such as code writing, video viewing time, and question answering with the knowledge graph, a probabilistic graph model or a deep learning model is used to accurately build a user interest model, and a dynamic interest update mechanism is equipped with trigger conditions such as significant changes in learning behavior patterns and completion of specific programming projects. In the core calculation process, the graph path search based on the heuristic search strategy, the node similarity measurement based on the calculation of the cosine similarity of the semantic vector, and the reinforcement learning idea are integrated to continuously generate and optimize the recommendation list. After experiments on real data sets collected from well-known online programming learning platforms, compared with classic algorithms such as traditional collaborative filtering, content-based recommendation, and matrix decomposition, the new algorithm has an accuracy increase of 25%, a recall increase of 18%, an F1 value increase of 22%, and an average accuracy increase of 20%. It has performed well in tests of different data set sizes and user groups, and has effectively promoted the personalized and efficient development of programming education.},
keywords={Learning systems;Computer languages;Accuracy;Heuristic algorithms;Education;Semantics;Knowledge graphs;Data models;Dynamic programming;Programming profession;Knowledge graph;programming course;teaching resource recommendation;algorithm design;experimental simulation},
