@INPROCEEDINGS{11470870,
author={Hidayatullah, Lukman Alfaris and Wisudawan, Gede Agung Ary and Nurtantyana, Rio},
booktitle={2025 International Conference on Artificial Intelligence, Blockchain, Cloud Computing, and Data Analytics (ICoABCD)}, 
title={The Development of an Interactive Programming Learning Platform with AI-Driven Feedback and Online Code Execution for the Java Language}, 
year={2025},
volume={},
number={},
pages={1-6},
abstract={Programming education often encounters challenges in delivering fast, easily understood feedback when students run into errors in their code. Traditional approaches that rely on manual debugging and searching for solutions on online forums which are time-consuming and can undermine learners' motivation. To address these issues, we have developed a web-based interactive platform for learning Java object-oriented programming that integrates AI-generated feedback with online code execution. In details, the platform seamlessly integrates online code execution, learning materials, weekly timed quizzes with auto-grading, progress tracking, and a multi-file workspace with AI-powered feedback-eliminating context-switching between learning and practice environments, which designed specifically for novice students. The evaluation included two weeks of developer-led functional testing and classroom settings deployment with 40 students. The functional pass rates were 100% for quizzes, coding task submission, learning progress, ratings, and authentication; 95% for AI features; and 89% for code execution, with failures traced to external API constraints. During user testing, students generated 1,019 AI-feedback interactions, which they rated 4.61 on average; the mean AI response time was 3.8 seconds. The results indicated positive acceptance of AI support with a mean of 4.08. The user testing highlighted priorities for hardening and performance, such as resolving workspace auto-refresh via better state management, implementing robust autosave, improving execution error handling, optimizing database queries, enhancing caching, and adding loading states. Additional roadmap items include refining AI feedback for complex logic, mobile responsiveness, notifications, and offline access. These results demonstrate the platform's potential as an engaging and effective tool for programming instruction.},
keywords={Feedback;Circuits;Filtering;Filters;Radio access networks;Regional area networks;Videos;Cloud computing;Protocols;Internet;AI Feedback;code execution;Java syntax;objectoriented programming;functional testing},
