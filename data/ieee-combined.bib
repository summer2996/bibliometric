journal={2025 IEEE/ACM 33rd International Conference on Program Comprehension (ICPC)},
author_keywords={Codes;Source coding;Large language models;Graphics processing units;Manuals;Programming;Prompt engineering;Tuning;Optimization;Prompt Engineering;Instruction finetuning},
