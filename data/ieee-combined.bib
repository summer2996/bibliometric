@INPROCEEDINGS{11400936,
author={Guo, Siqi and Tang, Zhihao},
booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
title={Multi-Layer Feature Fusion for Detecting AI-Generated Code in Programming Education}, 
year={2025},
volume={},
number={},
pages={3631-3639},
abstract={The rapid development of large language models (LLMs) has enhanced their ability to produce coherent and contextually relevant text, but also raised concerns about the misuse of AI -generated content, creating a need for effective detection methods. Recent surveys report widespread generative AI adoption in higher educationj l], highlighting risks to aca-demic integrity. Compared to text, generative AI shows stronger performance in coding tasks, making source-code detection a critical focus. While zero-cost detectors such as DetectGPT[2] achieve high accuracy, they incur high computational cost and lack code-specific optimizations. We propose ShanghaiTect, an AIGC detector for algorithmic code that integrates four feature types: watermarks, statistical measures (perplexity, burstiness), structural characteristics (AST, TF-IDF), and semantic embed-dings from CodeBERT[3]. This multi-layer pipeline enables faster runtime and stable accuracy while providing pre-screening for watermarked code. Experiments on a dataset of 18,393 Python and C++ code snippets show that ShanghaiTect matches or exceeds state-of-the-art baselines across multiple generative mod-els, improving code-specific detection accuracy and demonstrating stronger cross-model generalization. Across all evaluations, ShanghaiTect achieves an average accuracy of approximately 98%, with notable improvements in both detection performance and computational efficiency compared to existing detectors.},
keywords={Codes;Accuracy;Generative AI;Large language models;Trees (botanical);Semantics;Detectors;Watermarking;Feature extraction;Computational efficiency;AI-Generated Code Detection;Large Language Models;Watermarking;Abstract Syntax Tree;Code Semantics;Perplexity},
