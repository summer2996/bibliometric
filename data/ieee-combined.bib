@INPROCEEDINGS{11425452,
author={Juwono, Ronny and Apriansyah, Ryan and Suroso, Jarot S.},
booktitle={2025 13th International Conference on Orange Technology (ICOT)}, 
title={Teachers’ and Students’ Perceptions of Google Gemini Integration in Basic Programming Instruction: A Case Study at SMKN 7 Tangerang Regency}, 
year={2025},
volume={},
number={},
pages={1-4},
abstract={The rapid development of generative artificial intelligence (AI) has created new opportunities to support programming education, including in vocational schools. This study explores teachers’ and students’ perceptions of integrating Google Gemini into basic programming instruction at SMKN 7 Tangerang Regency, Indonesia. A descriptive qualitative design was employed, using semi-structured interviews, focus group discussions, and classroom observations to collect data from [X] teachers and [Y] students in the Software Engineering program. The data were analyzed using the Miles and Huberman framework of data reduction, data display, and conclusion drawing. The findings indicate that teachers perceive Google Gemini as helpful for explaining abstract programming concepts, providing examples, and giving immediate feedback, while also raising concerns related to classroom management, students’ overreliance on AI, and the need for digital competency. Students report that Google Gemini increases motivation, helps them understand syntax and logic, and supports independent practice, but they also experience confusion when responses are inaccurate or too complex. Overall, the study shows that Google Gemini can enhance programming instruction in vocational settings when it is integrated with clear pedagogical guidance and critical AI literacy. The results provide practical implications for teachers, school leaders, and policymakers planning to adopt generative AI tools in vocational education.},
keywords={Training;Generative AI;Large language models;Syntactics;Internet;Planning;Logic;Interviews;Programming profession;Software engineering;Google Gemini;Large Language Models;Programming Education;Vocational Schools},
