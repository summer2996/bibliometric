@INPROCEEDINGS{11413336,
author={Tian, Hao and Li, Xiaobin and Ren, Jie},
booktitle={2025 International Conference on Educational Technology Management (ICETM)}, 
title={Research on the Impact of Generative Artificial Intelligence on Middle School Students' Programming Knowledge Mastery and Computational Thinking}, 
year={2025},
volume={},
number={},
pages={377-381},
abstract={Generative Artificial Intelligence (GAI) is rapidly emerging as a pivotal force for innovating pedagogical models and improving learning outcomes. Its robust capacity for code generation and explanation has attracted substantial attention in programming education. This study proposes a GAI-based progressive guided teaching model designed to enhance students' programming knowledge mastery and cultivation of computational thinking. Structured around four sequential phases—knowledge activation, problem deconstruction, solution construction, and iterative optimization—the model scaffolds learners step-by-step through programming tasks while preventing direct, answer-oriented reliance on GAI, thereby fostering deep comprehension and sustained competency development. A quasi-experimental design involving 60 senior-high-school students confirmed the model's effectiveness: participants exhibited significant gains in syntax mastery and algorithmic thinking within programming knowledge, as well as marked improvements in the four core dimensions of computational thinking—problem decomposition, pattern recognition and modeling, logical abstraction and expression, and algorithm design and evaluation. By meaningfully integrating GAI into programming teaching, this research offers a replicable paradigm for AI-enhanced programming education.},
keywords={Codes;Generative AI;Computational modeling;Force;Learning (artificial intelligence);Educational technology;Syntactics;Pattern recognition;Iterative methods;Programming profession;generative artificial intelligence;programming teaching;programming knowledge;computational thinking},
