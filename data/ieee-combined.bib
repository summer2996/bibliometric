@INPROCEEDINGS{10513415,
author={Zhou, Pinghong and Li, Yixin and Zhang, Yi and Yu, Yue and Tang, Yumin},
booktitle={2023 Twelfth International Conference of Educational Innovation through Technology (EITT)}, 
title={The Effects of Scaffolding on Learning Outcomes in K-12 Programming Education: A Meta-Analysis}, 
year={2023},
volume={},
number={},
pages={46-50},
abstract={Scaffolding is widely used by teachers and researchers in K-12 programming education as an important tool to enhance learning outcomes; however, there has not been a synthesis of research findings on its effects. This meta-analysis reviewed 39 effect sizes from 22 articles from 2007– 2022 on the use of scaffolding in K-12 programming education to fill this gap, aiming to provide theoretical and practical information on scaffolding-based programming education. The total effect showed that scaffolding in K-12 programming education had a medium effect on learning outcomes (g = 0.666). Moderated effects analysis showed statistically significant differences in the effects of different educational stages, scaffolding strategies, scaffolding purposes, scaffolding scopes, and scaffolding providers. The results of this meta-analysis reinforce the argument for considering scaffolding as a powerful learning tool in K-12 programming education and reveal important factors that should be considered when designing scaffolding in K12 programming education.},
keywords={Technological innovation;Education;Programming profession;scaffolding;programming education;k12;meta-analysis;effect size},
