@INPROCEEDINGS{10031183,
author={Zhu, Renyu and Zhang, Dongxiang and Han, Chengcheng and Gaol, Ming and Lu, Xuesong and Qian, Weining and Zhou, Aoying},
booktitle={2022 IEEE International Conference on Data Mining Workshops (ICDMW)}, 
title={Programming Knowledge Tracing: A Comprehensive Dataset and A New Model}, 
year={2022},
volume={},
