@INPROCEEDINGS{9829512,
author={Wang, Jia-Yin and Liang, Jia-Chi},
booktitle={2022 IEEE 5th Eurasian Conference on Educational Innovation (ECEI)}, 
title={CodingHere: Online Judge and Assessment System for Programming Course}, 
year={2022},
volume={},
number={},
pages={126-129},
abstract={CodingHere is an online system specially designed for programming courses. Teachers use it to easily manage classes, assignments, and exams, while students use it to practice coding skills online. It provides teachers with functions such as units and homework, exam management, problem set management, user learning records, programming language restrictions, and so forth. Through CodingHere, teachers can quickly grasp the performance of the whole class, and check the difficulties of individual students. For students, when they submit code, CodingHere judges the code in time and returns detailed feedback. If syntax errors occur, it provides students with full compilation error messages and syntax hints. If logic errors occur, it shows an example of the error with random input. This information is helpful for beginner students to debug. In addition, CodingHere checks the formatting of the submitted C/C++ code and returns corrective feedback for poorly-formatted parts. In our experience, CodingHere helps teachers teach programming and students learn programming more easily. As one student mentioned, "CodingHere is a learning platform for students to practice coding. It gives us more opportunities to learn and helps us improve our coding skills."},
