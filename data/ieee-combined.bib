@INPROCEEDINGS{11254856,
author={Pianprasit, Peerasak and Phakdee, Nuttaporn and Arbking, Jirayus and Suttapakti, Ungsumalee and Chinnasarn, Krisana},
booktitle={2025 IEEE/ACIS 29th International Conference on Software Engineering, Artificial Intelligence, Networking and Parallel/Distributed Computing (SNPD)}, 
title={Machine Learning-Based API Framework for Adaptive Programming Learning Using Educational Programming Features}, 
year={2025},
volume={},
number={},
pages={455-460},
abstract={This paper presents a machine learning-based API framework for adaptive programming learning. The system evaluates learner performance using source code metrics (e.g., Lines of Code, Cyclomatic Complexity), behavior (e.g., Time Spent, Attempts), and correctness. A Random Forest classifier is used to predict the appropriate next learning level based on historical learner performance data. The backend is built with FastAPI and deployed via Docker, while the frontend is developed using Nuxt.js. A key feature of our approach is its modularity, allowing future integration of hybrid models. We evaluate the system using a diverse set of simulated learner profiles and compare its performance against a rule-based baseline method. These results suggest that the framework is both adaptable and interpretable, with a modular design that facilitates extensibility.},
