@CONFERENCE{Zhou202346,
	author = {Zhou, Pinghong and Li, Yixin and Zhang, Yi and Yu, Yue and Tang, Yumin},
	title = {The Effects of Scaffolding on Learning Outcomes in K-12 Programming Education: A Meta-Analysis},
	year = {2023},
	journal = {Proceedings - 2023 12th International Conference of Educational Innovation through Technology, EITT 2023},
	pages = {46 - 50},
	doi = {10.1109/EITT61659.2023.00016},
	url = {https://www.scopus.com/pages/publications/85193979784?origin=resultslist},
	affiliations = {Central China Normal University, Faculty of Artificial Intelligence in Education, Wuhan, China},
	abstract = {Scaffolding is widely used by teachers and researchers in K-12 programming education as an important tool to enhance learning outcomes; however, there has not been a synthesis of research findings on its effects. This meta-analysis reviewed 39 effect sizes from 22 articles from 2007- 2022 on the use of scaffolding in K-12 programming education to fill this gap, aiming to provide theoretical and practical information on scaffolding-based programming education. The total effect showed that scaffolding in K-12 programming education had a medium effect on learning outcomes (g = 0.666). Moderated effects analysis showed statistically significant differences in the effects of different educational stages, scaffolding strategies, scaffolding purposes, scaffolding scopes, and scaffolding providers. The results of this meta-analysis reinforce the argument for considering scaffolding as a powerful learning tool in K-12 programming education and reveal important factors that should be considered when designing scaffolding in K12 programming education. © 2023 IEEE.},
