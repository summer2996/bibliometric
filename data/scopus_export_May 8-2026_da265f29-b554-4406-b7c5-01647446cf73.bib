	title = {INSIGHT: An Explainable, Instructor-Guided AI Assistant for Active Learning in CS1},
	year = {2026},
	journal = {SIGCSE TS 2026 - Proceedings of the 57th ACM Technical Symposium on Computer Science Education V.2},
	pages = {1363 - 1364},
