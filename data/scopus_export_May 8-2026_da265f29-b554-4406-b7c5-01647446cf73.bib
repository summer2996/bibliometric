@CONFERENCE{Chuan2025298,
	author = {Chuan, Ong Yew and Singh, Upasana and Alwi, Sharifah Sumayyah Engku and Usop, Nor Surayati and Muda, Roslinda and Bongsu, Raja Hasyifah Raja},
	title = {Integrating AI Literacy in Programming Education: Enhancing Object-Oriented Design and Problem-Solving Skills},
