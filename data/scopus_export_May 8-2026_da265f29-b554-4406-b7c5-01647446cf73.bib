@CONFERENCE{López-Pernas2025,
	author = {López-Pernas, Sonsoles and Misiejuk, Kamila and Oliveira, Eduardo and Saqr, Mohammed},
	title = {The dynamics of the self-regulation process in student-AI interactions The case of problem-solving in programming education},
	year = {2025},
	journal = {Proceedings of 25th International Conference on Computing Education Research, Koli Calling 2025},
	pages = {},
