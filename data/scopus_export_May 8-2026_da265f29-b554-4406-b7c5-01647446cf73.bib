	journal = {SIGCSE TS 2026 - Proceedings of the 57th ACM Technical Symposium on Computer Science Education V.1},
	pages = {1068 - 1074},
	doi = {10.1145/3770762.3772501},
	url = {https://www.scopus.com/pages/publications/105031902778?origin=resultslist},
	affiliations = {University of California, Irvine, Irvine, CA, United States},
	abstract = {Large Language Models (LLMs) hold significant potential for transforming computer science education, yet concerns over their possible negative effects on student learning and retention have slowed broader instructor adoption. Evidence on LLM use is mixed. While novices may benefit from the generative capabilities of AI, they also risk developing overreliance. To address these concerns, we investigate how the pace of interaction with AI assistants affects learning in introductory CS courses by deploying three AI assistants (Fast, Medium, and Slow) in a classroom setting. Our results show that the slower-paced, Socratic-style AI assistant significantly increases learning, especially for students with less prior knowledge. Although faster-paced interaction benefits more advanced students initially, learning retention degrades enough to negate those gains. Surprisingly, the medium-paced assistant with typical instructor preprompt elements shows no statistically significant improvements. Given that students may use fast-paced commercial AI tools for coursework regardless of policy, offering a slower-paced, Socratic-style AI alternative could meaningfully improve overall student learning outcomes. © 2026 Copyright held by the owner/author(s).},
	author_keywords = {AI assistants; classroom; CS1; Generative AI; interaction pace; learning; LLMs; novice programmers; retention},
	keywords = {Artificial intelligence; Curricula; Education computing; Engineering education; Human engineering; Students; AI assistant; Classroom; Generative AI; Interaction pace; Language model; Large language model; Learning; Model interaction; Novice programmer; Retention; Teaching},
	correspondence_address = {T.Y. Yeh; University of California, Irvine, Irvine, United States; email: tomyeh@uci.edu},
	publisher = {Association for Computing Machinery, Inc},
