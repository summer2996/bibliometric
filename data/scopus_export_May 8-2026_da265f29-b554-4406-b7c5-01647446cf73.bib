@CONFERENCE{Kandjimi2025292,
	author = {Kandjimi, Herman and Suleman, Hussein},
	title = {Personalized Feedback Generation from Common Programming Approaches},
	year = {2025},
	journal = {Proceedings of the 2025 17th International Conference on Education Technology and Computers, ICETC 2025},
	pages = {292 - 297},
	doi = {10.1109/ICETC66579.2025.11387503},
	url = {https://www.scopus.com/pages/publications/105035172663?origin=resultslist},
	affiliations = {University of Cape Town, School of IT, Department of Computer Science, Cape Town, South Africa},
	abstract = {Novice programming students often face challenges in decision-making during problem-solving activities, leading to confusion and uncertainty about subsequent steps. This issue extends to teaching staff in programming education, who struggle to identify the specific junctures where students face difficulties and determine the best path forward for each individual. Markov Decision Processes (MDPs) provide a proven framework for handling such scenarios. This study transforms student solution approaches into Markov states and then leverages Large Language Models(LLMs) to generate personalized hints for each identified programming approach. Three levels of hints with varying abstraction were generated by an LLM and evaluated by human tutors. The results indicate that the proposed approach actually identifies common programming behaviours and confirms the quality of information presented in the generated hints of our implementation, with minimal fabricated content. Additionally, human tutors outlined the need to find a balance in levels of abstraction when providing hints to enhance conceptual understanding and encourage problem-solving and experimentation. © 2025 IEEE.},
