@ARTICLE{Wysokinska202650908,
	author = {Wysokinska, Aleksandra and Duch, Piotr and Bartosik, Bartosz and Chrustowski, Kamil and Durys, Bartosz and Fabijanska, Anna},
	title = {Can AI Code? A Head-to-Head Showdown Between Large Language Models and Student Programmers in C},
	year = {2026},
	journal = {IEEE Access},
