@CONFERENCE{Pesovski2024,
	author = {Pesovski, Ivica and Vorkel, Daniela and Trajkovik, Vladimir},
	title = {AI-Powered Education: Rethinking the Way Programming is Taught Using AI Tools and Reversed Bloom's Taxonomy},
	year = {2024},
	journal = {2024 21st International Conference on Information Technology Based Higher Education and Training, ITHET 2024},
	pages = {},
	doi = {10.1109/ITHET61869.2024.10837604},
	url = {https://www.scopus.com/pages/publications/85218098662?origin=resultslist},
	affiliations = {Brainster Next College, Computer Science and Innovation, Skopje, North Macedonia; Independent Researcher, Leipzig, Germany; Ss. Cyril and Methodius University, Faculty of Computer Science & Engineering, Skopje, North Macedonia},
	abstract = {Artificial intelligence (AI) is revolutionizing the way programming is taught and learnt and is redefining t he way programming skills are assessed in the continuously changing field of computer science education. This paper introduces a novel approach for teaching and evaluating programming knowledge by reversing Bloom's taxonomy in order to accommodate AI-powered learning. Traditionally, Bloom's taxonomy progresses from basic cognitive skills like remembering and understanding to advanced skills like creating. With AI tools such as WebSim.ai and Anthropic Artifacts now capable of generating sophisticated outputs, the focus shifts away from students' ability to create, as these tools handle that task effectively. Instead, this paper proposes placing a higher emphasis on students' ability to understand and critically analyze AI -generated solutions, assessing their comprehension and ability to reverse-engineer existing work. We call this the Reverse Bloom Taxonomy, where students begin with creation and then move toward deeper understanding of the subject matter. This paper outlines the methodology for applying this reversed framework in programming education and presents a promising concept for improving student learning outcomes. The discussion addresses challenges in implementation and emphasizes the strategic integration of AI -driven learning to prepare students for a technology-driven workforce. © 2024 IEEE.},
	author_keywords = {AI in education; AI-powered education; educational AI; generative AI; pedagogical innovation; programming education; reversed bloom taxonomy},
	keywords = {Adversarial machine learning; Blooms (metal); Federated learning; Students; Artificial intelligence in education; Artificial intelligence tools; Artificial intelligence-powered education; Bloom taxonomies; Educational artificial intelligence; Generative artificial intelligence; Learn+; Pedagogical innovation; Programming education; Reversed bloom taxonomy; Contrastive Learning},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833151663-5},
	language = {English},
	abbrev_source_title = {Int. Conf. Inf. Technol. Based High. Educ. Train., ITHET},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
