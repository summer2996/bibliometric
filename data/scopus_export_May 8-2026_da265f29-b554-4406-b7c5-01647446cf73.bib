	year = {2026},
	journal = {Proceedings of 2025 2nd International Conference on Artificial Intelligence and Future Education, AIFE 2025},
	pages = {84 - 91},
	doi = {10.1145/3785987.3786000},
	url = {https://www.scopus.com/pages/publications/105029712630?origin=resultslist},
	affiliations = {Chengdu Jincheng College, Sichuan, Chengdu, China},
	abstract = {Traditional programming pedagogy formalizes development into rigid, pre-defined steps (e.g., upfront flowcharting, mathematical modeling) that introduce extraneous complexity, impeding beginners’ mastery of assembly language. This paper presents a computationally grounded”deductive and progressive” (D&P) methodology for assembly programming education, anchored in stepwise algorithmic deduction, register-transfer-level (RTL) modeling, and empirical validation of student performance. Unlike the”inductive overview” approach, the D&P method starts from problem-specific memory/register operations, iteratively refines pseudocode into syntactically valid assembly instructions, and integrates cyclic/branch control logic through incremental optimization. We formalize the D&P process with algorithmic pseudocode, quantify its efficacy via pre/post-test performance metrics (including code efficiency and error rates), and validate it against traditional methods using a controlled experiment with 62 students. Results show the D&P method increases task success rates by 431% (p<0.001) and reduces average code debugging time by 37.2%. This work contributes a technically rigorous, cognitive-aligned pedagogy that bridges the gap between programming theory and hands-on assembly implementation. © 2025 Copyright held by the owner/author(s).},
