	title = {Exploration and Practice of Code Commenting Based on Prompt Engineering},
	year = {2025},
	journal = {2025 7th International Conference on Computer Science and Technologies in Education, CSTE 2025},
	pages = {98 - 102},
	doi = {10.1109/CSTE64638.2025.11092128},
