	title = {AI-Generated Code Detection: An Examination of Current Tools in Education},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {15723 LNCS},
	pages = {192 - 201},
	doi = {10.1007/978-3-031-98281-1_15},
