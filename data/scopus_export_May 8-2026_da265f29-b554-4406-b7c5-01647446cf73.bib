	title = {Visualizing Program Behavior: A Study of Enhanced Program Diagrams Using LLM},
	year = {2024},
	journal = {Proceedings - Frontiers in Education Conference, FIE},
	pages = {},
	doi = {10.1109/FIE61694.2024.10893082},
