@ARTICLE{Wang2026991,
	author = {Wang, Yong and Meng, Shuai and Fang, Yingtao and Gao, Cuiyun and Huang, Yourui},
	title = {API Recommendation for Novice Programmers: From Clear Expressions to Effective Results},
	year = {2026},
	journal = {IEEE Transactions on Reliability},
	volume = {75},
	pages = {991 - 1005},
	doi = {10.1109/TR.2026.3664018},
	url = {https://www.scopus.com/pages/publications/105030259253?origin=resultslist},
	affiliations = {Anhui Polytechnic University, Wuhu, 241000, China; Harbin Institute of Technology, Harbin Institute of Technology, Shenzhen, 518055, China},
	abstract = {Application programming interface (API) recommendation systems for novice programmers should prioritize usability and inspiration rather than merely pursuing the “best result.” Existing retrieval-based approaches, whether relying on direct similarity matching or using query expansion to generate clarification options, still cannot recover missing task semantics and often introduce additional ambiguity and interaction overhead. Learning-based methods, including neural architectures and recent large language model (LLM)-driven techniques, require substantial data or strong prompt dependence and provide limited transparency, making it difficult to align model outputs with novice programmers' actual intent. To address these limitations, we propose intention-oriented and context-aware API (IOCAPI) recommendation, a reasoning-driven framework that integrates LLMs, LCMs, and in-context learning. It mainly contains three components. 1) Intent Detector, which refines the query and derives task semantics through model-generated I/O exemplars. 2) Code Generator, which produces representative code snippets under the confirmed I/O constraints. 3) Task Bridger, which consolidates the results into actionable API recommendations with interpretable code examples. Evaluations on three public datasets show that IOCAPI attains a 35.7% BLEU improvement over APIGen and an 11.1% MRR gain over CLEAR, and achieves higher MAP scores than GPT-4 zero-shot, few-shot, and chain-of-thought baselines by 102%, 11.2%, and 21.8%, respectively. A controlled user study involving seven real programming tasks further provides empirical observations of IOCAPI's behavior in practice. Compared with KAHAID, IOCAPI obtained higher average scores in correctness (1.67 versus 1.00), usability (1.76 versus 0.40), and inspiration (1.40 versus 0.26). © 1963-2012 IEEE.},
	author_keywords = {Application programming interface (API) recommendation; developers' API need; large code models; large language models (LLMs); novice programmers; query clarification},
	keywords = {Application programming interfaces (API); Behavioral research; Clarification; Clarifiers; Learning systems; Modeling languages; Semantics; API recommendation; Context-Aware; Developer ' API need; Direct similarities; Language model; Large code model; Large language model; Novice programmer; Query clarification; Similarity-matching; Codes (symbols)},
