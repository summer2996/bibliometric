	keywords = {Groupware; Human engineering; Information management; Integrodifferential equations; Scaffolds; Software prototyping; Software testing; Collaborative IDE; Collaborative software development; Novice programmer; Pair-programming; Real-time collaborative; Situational awareness; Testing infrastructure; Version control system; Software design},
