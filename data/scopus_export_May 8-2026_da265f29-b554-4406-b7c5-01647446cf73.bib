	affiliations = {Shaanxi Normal University, Department of Education, Xi'an Wuhuan Middle School, Shaanxi, Xi'an, China; Shaanxi Normal University, Department of Education, Shaanxi, Xi'an, China; School of Physics and Information Technology, Shaanxi Normal University, Shaanxi, Xi'an, China; School of Computer Science and Engineering, Northwest Normal University, Gansu, Lanzhou, China},
	abstract = {Generative artificial intelligence has demonstrated remarkable potential in the field of education due to its powerful text-based capabilities. However, its impact on programming education remains in the early exploratory phase, with limited empirical research available. This study involved 83 high school students to investigate the effects of generative AI-assisted programming on their computational thinking skills. A mixed-methods approach was adopted, incorporating tests and semi-structured interviews to collect both quantitative and qualitative data. The results indicate that generative AI-assisted programming significantly enhances students' computational thinking skills. Furthermore, this learning strategy promotes personalized learning of programming. The findings of this study can be applied in practical programming education to improve students' computational thinking. © 2025 IEEE.},
