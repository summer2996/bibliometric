@CONFERENCE{Tran20261068,
	author = {Tran, Karena and Gao, Ge and Lombard, Angela and Yu, Tyler and Jiang, Haoning and Yeh, Thomas Y.},
	title = {Pacing for Mastery: Optimizing LLM Interactions for Learning},
