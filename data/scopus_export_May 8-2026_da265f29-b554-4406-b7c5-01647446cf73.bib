@ARTICLE{Koike202163,
	author = {Koike, Kento and Fujishima, Yuki and Tomoto, Takahito and Horiguchi, Tomoya and Hirashima, Tsukasa},
	title = {Learner Model for Adaptive Scaffolding in Intelligent Tutoring Systems for Organizing Programming Knowledge},
	year = {2021},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {12766 LNCS},
	pages = {63 - 74},
	doi = {10.1007/978-3-030-78361-7_6},
	url = {https://www.scopus.com/pages/publications/85138385770?origin=resultslist},
	affiliations = {Graduate School of Engineering, Tokyo Polytechnic University, Kanagawa, Atsugi, Japan; Faculty of Engineering, Tokyo Polytechnic University, Kanagawa, Atsugi, Japan; Graduate School of Maritime Sciences, Kobe University, Hyogo, Kobe, Japan; Graduate School of Advanced Science and Engineering, Hiroshima University, Hiroshima, Higashi-hiroshima, Japan},
	abstract = {Learner models are constructed from learner understanding states regarding learning materials, obtained by observing learner behaviors. A learner model collects information for adaptive tutoring and uses this information to determine system actions such as hints, problem presentations, and explanations appropriate to learner understanding. A learner model thus plays an essential role in intelligent tutoring systems (ITSs). Our previously developed ITSs have adopted a simple learner model that considers once-solved problems as learner-acquired solutions for problem solving. However, such models cannot grasp learner proficiency for solutions, which is an important aspect of constructing learner models because learners often make problem-solving mistakes despite having already learned the solution. In such situations, it is effective for an ITS to apply scaffolding based on learner proficiency regarding the solution. However, excess scaffolding decreases comprehension, a phenomenon known as the “assistance dilemma.” A learner model that adap-tively scaffolds based on analysis of learner proficiency in solutions can effectively mitigate the assistance dilemma. In this study, we develop and evaluate an ITS with a learner model that considers learner proficiency in solutions. Experimental results indicate that the developed learner model can reduce total feedback without changing learner comprehension. © Springer Nature Switzerland AG 2021.},
	author_keywords = {Adaptive scaffolding; Intelligent tutoring system; Knowledge organization; Learner model; Programming education},
	keywords = {Computer aided instruction; Education computing; Intelligent vehicle highway systems; Scaffolds; Adaptive scaffolding; Intelligent tutoring; Intelligent tutoring system; Knowledge organization; Learner modeling; Learning materials; Problem-solving; Programming education; Programming knowledge; Tutoring system; Learning systems},
	correspondence_address = {K. Koike; Graduate School of Engineering, Tokyo Polytechnic University, Atsugi, Kanagawa, Japan; email: k.koike@t-kougei.ac.jp},
