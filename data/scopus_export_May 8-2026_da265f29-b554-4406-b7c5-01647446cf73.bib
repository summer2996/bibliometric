@CONFERENCE{Chi2025661,
	author = {Chi, Wenji},
	title = {Design and Empirical Research of Personalized Programming Teaching System Based on Generative AI},
	year = {2025},
	journal = {2025 IEEE 3rd International Conference on Electrical, Automation and Computer Engineering, ICEACE 2025},
	pages = {661 - 665},
