@CONFERENCE{Almeida2025,
	author = {Almeida, André and Guerrero, Dalton D. S. and Andrade, Wilkerson L.},
	title = {Fostering Problem-Solving in Introductory Programming Through Software Testing: A Systematic Review},
	year = {2025},
	journal = {Proceedings - Frontiers in Education Conference, FIE},
	pages = {},
	doi = {10.1109/FIE63693.2025.11328234},
	url = {https://www.scopus.com/pages/publications/105033071825?origin=resultslist},
	affiliations = {Federal University of Campina Grande, PB, Campina Grande, Brazil},
	abstract = {This Research Full Paper presents a systematic review of the integration of software testing practices in introductory programming courses. Software testing, a critical skill in programming, has the potential to transform the way students approach problem-solving and programming tasks. However, the process of teaching these practices in beginner courses presents unique challenges and opportunities. The primary objective of this study is to examine how software testing practices are incorporated into programming courses, their effectiveness in enhancing students' logical and analytical reasoning, and the challenges associated with their implementation. To address these goals, a systematic literature review (SLR) was conducted, guided by three units of analysis: (1) the stages of problem-solving supported by testing, (2) the metrics used to evaluate its effectiveness, and (3) the findings of current practices. The findings reveal that testing can be introduced at different stages of problemsolving, including writing test cases before coding, metacognitive scaffolding to plan solutions, and using frameworks to integrate continuous feedback. Metrics such as academic performance, problem-solving accuracy, engagement, and solution validation were used to evaluate the effectiveness of these approaches. Additionally, the research notes the need for further exploration of how these practices can be adapted to real-world scenarios and different educational contexts. © 2025 IEEE.},
