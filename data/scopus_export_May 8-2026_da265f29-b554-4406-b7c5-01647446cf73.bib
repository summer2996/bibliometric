@CONFERENCE{Margulieux201721,
	author = {Margulieux, Lauren and Catrambone, Richard},
	title = {Using learners' self-explanations of subgoals to guide initial problem solving in app inventor},
	year = {2017},
	journal = {ICER 2017 - Proceedings of the 2017 ACM Conference on International Computing Education Research},
	pages = {21 - 29},
