@CONFERENCE{Bejarano20251383,
	author = {Bejarano, Andres and Dickey, Ethan and Kuperus, Rhianna},
	title = {Implementing the AI-Lab Framework: Enhancing Introductory Programming Education for CS Majors},
	year = {2025},
	journal = {SIGCSE TS 2025 - Proceedings of the 56th ACM Technical Symposium on Computer Science Education},
