@CONFERENCE{Demirtaş20251435,
	author = {Demirtaş, Mehmet Arif and Zheng, Claire and Cunningham, Kathryn},
	title = {Detecting Programming Plans in Open-ended Code Submissions},
	year = {2025},
	journal = {SIGCSE TS 2025 - Proceedings of the 56th ACM Technical Symposium on Computer Science Education},
	volume = {2},
	pages = {1435 - 1436},
