@ARTICLE{Bernik2025,
	author = {Bernik, Andrija and Radošević, Danijel and Čep, Andrej},
	title = {A Comparative Study of Large Language Models in Programming Education: Accuracy, Efficiency, and Feedback in Student Assignment Grading},
