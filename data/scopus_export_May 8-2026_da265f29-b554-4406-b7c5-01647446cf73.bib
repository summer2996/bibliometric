@CONFERENCE{Li2025196,
	author = {Li, Jieying and Ren, Qiuyi and Liu, Jiahua and Zhu, GeXin and Liu, Yichen},
	title = {A Study of Automated Evaluation of Programming Short-Answer Questions Based on Large Language Models},
	year = {2025},
	journal = {2025 10th International Conference on Distance Education and Learning, ICDEL 2025},
	pages = {196 - 200},
	doi = {10.1109/ICDEL65868.2025.11193637},
	url = {https://www.scopus.com/pages/publications/105022456287?origin=resultslist},
	affiliations = {Henan University of Economics and Law, Zhengzhou, China},
	abstract = {In programming education, the assessment of short-answer questions can effectively reflect students' thinking and viewpoints. However, traditional manual assessment is time-consuming and prone to subjective biases, leading to inaccurate results. With the continuous advancement of Large Language Models (LLMs), their potential for automating the grading of programming short-answer questions has become increasingly evident, offering a solution to the limitations of manual assessment. However, the application of LLMs in programming education, particularly for automated grading, remains in the exploratory stage. This study aims to investigate the effectiveness of LLMs in automating the grading of programming short-answer questions by employing multiple LLMs (GPT-4o, DeepSeek-V3, and DeepSeek-R1) in conjunction with various prompting strategies to evaluate student responses and compare their grading performance. The results indicated that, in terms of grading consistency and accuracy, GPT-4o demonstrated the best performance, followed by DeepSeek-V3, while DeepSeek-R1 showed relatively weaker results. Moreover, different prompt strategies had a significant impact on the grading performance of GPT-4o, whereas DeepSeek-R1 exhibited greater stability. Further research revealed that a prompt strategy combining few-shot examples with basic templates, grading criteria, and chain-of-thought reasoning achieved the best performance in terms of grading consistency and accuracy. This strategy also showed excellent adaptability and stability across different models. © 2025 IEEE.},
	author_keywords = {DeepSeek; GPT-4o; Large language models; Prompt strategies; Short-answer automatic assessment},
