@ARTICLE{Yang2026,
	author = {Yang, Wudao and Wong, Seng Yue and Obaidellah, Unaizah},
	title = {Automated token-level AOIs using OCR for predicting novice programmers' visual attention},
	year = {2026},
	journal = {International Journal of Modern Physics C},
	pages = {},
	doi = {10.1142/S0129183125420239},
	url = {https://www.scopus.com/pages/publications/105031680721?origin=resultslist},
	affiliations = {Department of Artificial Intelligence, Faculty of Computer Science and Information Technology, Universiti Malaya, Kuala Lumpur, 50603, Malaysia; School of Mathematics and Computer Science, Yunnan Minzu University, Kunming, 650000, China; Academy of Malay Studies, Universiti Malaya, Kuala Lumpur, 50603, Malaysia},
	abstract = {This paper introduces Gaze2Code, a novel cognitive modeling framework designed to support novice programming comprehension through automated token-level Area of Interest (AOI) generation using Optical Character Recognition (OCR). By aligning OCR-processed code images with eye-Tracking data, the framework achieves precise fixation-To-Token mapping, enabling fine-grained analysis of visual attention. A robust OCR optimization pipeline incorporating adaptive thresholding, contrast normalization, and token confidence filtering significantly improves token detection accuracy, bounding box alignment, and semantic coverage. Empirical evaluations across multiple programming tasks demonstrate substantial gains in AOI quality and predictive performance, with optimized AOIs enhancing BiLSTM model fit in modeling gaze behavior. The framework not only advances high-resolution attention modeling but also enables the concrete identification of comprehension strategies, such as novice regressions to operators or repeated fixations on delimiters and loop constructs, thereby supporting the development of adaptive, gaze-sensitive learning environments. This work represents an important step toward scalable and intelligent tutoring systems that deliver real-Time feedback in programming education.  © 2025 The Author(s).},
	author_keywords = {attention prediction; eye tracking; neural networking; novice programmers; OCR; Programming comprehension; token-level AOI},
	correspondence_address = {U. Obaidellah; Department of Artificial Intelligence, Faculty of Computer Science and Information Technology, Universiti Malaya, Kuala Lumpur, 50603, Malaysia; email: unaizah@um.edu.my},
	publisher = {World Scientific},
	issn = {01291831},
	language = {English},
	abbrev_source_title = {Int. J. Mod. Phys. C},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

