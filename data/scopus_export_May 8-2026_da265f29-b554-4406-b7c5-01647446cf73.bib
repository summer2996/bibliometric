	affiliations = {Universidade Federal do Espírito Santo, Departamento de Informática, ES, Vitória, Brazil; Instituto Federal do Espírito Santo, Departamento de Informática, ES, Alegre, Brazil; Instituto Federal do Espírito Santo, Departamento de Educação, ES, Vitória, Brazil},
	abstract = {This full research paper investigates the effectiveness of publicly available educational videos in teaching core concepts of computing and programming, such as abstraction, algorithms, data structures, and programming paradigms. As reliance on online instructional videos grows, it becomes essential to evaluate their pedagogical quality and depth of conceptual teaching. This study explores how well these videos convey fundamental computing principles and whether specific teaching approaches foster better conceptual understanding. A systematic review was conducted, selecting videos through clear criteria involving platform type, educational level, engagement metrics, and didactic structure. Custom-developed artificial intelligence tools were employed to transcribe, index, and categorize videos according to computing concepts. Qualitative and quantitative analyses examined pedagogical patterns, instructional clarity, conceptual depth, and learner engagement. Preliminary findings reveal that while videos commonly excel at teaching programming tools, they frequently lack comprehensive explanations of foundational theories, prioritizing practical implementation over conceptual understanding. Additionally, videos employing visual metaphors, structured explanations, and step-by-step problem-solving methods were found to enhance conceptual learning. These insights carry significant implications for educators, instructional designers, and content creators, emphasizing the need for structured and conceptually-rich video instruction. Future research will investigate interventions like AI-assisted recommendations and adaptive learning strategies to further improve the educational quality of online computing resources. © 2025 IEEE.},
	author_keywords = {artificial intelligence in education; Computing education research; conceptual learning; digital pedagogy; instructional design},
	keywords = {Artificial intelligence; E-learning; Education computing; Learning systems; Structured programming; Artificial intelligence in education; Computing and programming; Computing education; Computing education research; Conceptual learning; Conceptual understanding; Digital pedagogy; Education research; Instructional designs; Systematic Review; Teaching},
