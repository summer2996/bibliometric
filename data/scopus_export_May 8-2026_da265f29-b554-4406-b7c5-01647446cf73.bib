}

@CONFERENCE{Phung2026852,
	author = {Phung, Tung and Choi, Heeryung and Wu, Mengyan and Brooks, Christopher and Gulwani, Sumit and Singla, Adish},
	title = {Closing the Loop: An Instructor-in-the-Loop AI Assistance System for Supporting Student Help-Seeking in Programming Education},
	year = {2026},
	journal = {SIGCSE TS 2026 - Proceedings of the 57th ACM Technical Symposium on Computer Science Education V.1},
	pages = {852 - 858},
	doi = {10.1145/3770762.3772612},
	url = {https://www.scopus.com/pages/publications/105031898969?origin=resultslist},
	affiliations = {MPI-SWS, Saarbrücken, Germany; University of Minnesota, Twin Cities, United States; University of Michigan, Ann Arbor, United States; Microsoft, Redmond, United States},
	abstract = {Timely and high-quality feedback is essential for effective learning in programming courses; yet, providing such support at scale remains a challenge. While AI-based systems offer scalable and immediate help, their responses can occasionally be inaccurate or insufficient. Human instructors, in contrast, may bring more valuable expertise but are limited in time and availability. To address these limitations, we present a hybrid help framework that integrates AI-generated hints with an escalation mechanism, allowing students to request feedback from instructors when AI support falls short. This design leverages the strengths of AI for scale and responsiveness while reserving instructor effort for moments of greatest need. We deployed this tool in a data science programming course with 82 students. We observe that out of the total 673 AI-generated hints, students rated 146 (22%) as unhelpful. Among those, only 16 (11%) of the cases were escalated to the instructors. A qualitative investigation of instructor responses showed that those feedback instances were incorrect or insufficient roughly half of the time. This finding suggests that when AI support fails, even instructors with expertise may need to pay greater attention to avoid making mistakes. We will publicly release the tool for broader adoption and enable further studies in other classrooms. Our work contributes a practical approach to scaling high-quality support and informs future efforts to effectively integrate AI and humans in education. © 2026 Copyright held by the owner/author(s).},
	author_keywords = {Feedback Generation; Generative AI; Human-AI Collaboration; Programming Education},
	keywords = {Computer systems programming; Curricula; Education computing; Feedback; Teaching; Assistance system; Effective learning; Feedback generation; Generative AI; Help seeking; High quality; Human-AI collaboration; Programming course; Programming education; Quality feedbacks; Students},
	correspondence_address = {T. Phung; MPI-SWS, Saarbrücken, Germany; email: mphung@mpi-sws.org},
