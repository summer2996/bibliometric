	title = {Use of AI-driven Code Generation Models in Teaching and Learning Programming: a Systematic Literature Review},
	year = {2024},
	journal = {SIGCSE 2024 - Proceedings of the 55th ACM Technical Symposium on Computer Science Education},
	volume = {1},
	pages = {172 - 178},
