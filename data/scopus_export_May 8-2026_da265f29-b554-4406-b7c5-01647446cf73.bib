@CONFERENCE{Dos Santos2025,
	author = {Dos Santos, Otávio Lube and Cury, Davidson and Silveira, Pedro David Netto and De Andrade Perim, Wagner and Do Prado Rafalski, Jadson},
	title = {A Systematic Review of Video-Based Computing and Programming Education: Do Online Videos Really Teach Programming?},
