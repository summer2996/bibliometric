@CONFERENCE{de Araújo2025,
	author = {de Araújo, Adorilson Bezerra and Mendes, António José and Fonseca, Nuno Miguel Gil},
	title = {S2SM — Scaffolded 2-Spiral Model for Programming Learning},
	year = {2025},
	journal = {SIIE 2025 - 27th International Symposium of Education on Computers in Education},
	pages = {},
	doi = {10.1109/SIIE68580.2025.11368407},
	url = {https://www.scopus.com/pages/publications/105034372264?origin=resultslist},
	affiliations = {University of Coimbra, CISUC/LASI, DEI, Coimbra, Portugal; Instituto Politécnico de Coimbra, ESTGOH Oliveira do Hospital, Portugal},
	abstract = {This paper presents the evolution of the Scaffolded 2-Spiral Model (S2SM) for Programming Learning across two Design-Based Research cycles. The S2SM is a pedagogical framework that supports progressive programming learning through structured scaffolding. It comprises two spirals: in the first, students alternate between block-based and text-based programming, enabling a gradual and supported transition from visual to textual coding; in the second, they focus exclusively on textual programming to deepen conceptual understanding and programming fluency. Building on previous conceptual work, this study details the model’s pedagogical foundations—grounded in Use-Modify-Create and Predict-Run-Investigate-Modify-Make strategies—and its implementation through a hybrid curriculum that combines Code.org activities with Python’s turtle module and Free Python Games. Evidence from both Design-Based Research’s cycles suggests that block-based activities facilitated the transition to textual coding, reduced frustration, and fostered engagement and motivation. These findings reinforce the potential of the S2SM as a promising pedagogical approach for introductory programming education in high schools. © 2025 IEEE.},
