	affiliations = {Research and Development ActiviKid, Hong Kong; School of Engineering, University of Hong Kong, Department of Electrical and Electronic Engineering, Hong Kong},
	abstract = {This paper presents PleJ, a personalized e-learning framework designed to deliver a Java programming course that adapts to individual student learning paces and preferences. The framework features a three-level Java course, enabling course promotion and demotion based on student performance, thereby facilitating diverse learning pathways. PleJ leverages ontologies for the user model, domain model, and adaptation model, integrated within a rule-based expert system shell. This integration combines ontology reasoning with rule-based inference to deliver a personalized adaptive learning environment. The system incorporates web-based programming facilities, where student interactions within a programming environment are logged and synchronized with cloud storage for performance assessment. To evaluate learners for course progression, PleJ analyzes successive program compilation and debugging behaviors using a sophisticated scoring approach. Our implementation demonstrates the effectiveness of integrating and reusing information for adaptive learning within a web-based programming environment. © 2025 IEEE.},
