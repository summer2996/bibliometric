	title = {A Conceptual Framework for an LLM-Powered Multimodal Affective Tutoring System for Programming Education},
	year = {2025},
	journal = {Proceedings of 2025 3rd International Conference on Educational Knowledge and Informatization, EKI 2025},
	pages = {109 - 114},
