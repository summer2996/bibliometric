	title = {Is there a difference in cognition and behavior among learners with different learning styles when using GenAI-assisted learning? An empirical analysis based on programming learning},
	year = {2025},
	journal = {Interactive Learning Environments},
	pages = {},
	doi = {10.1080/10494820.2025.2589404},
