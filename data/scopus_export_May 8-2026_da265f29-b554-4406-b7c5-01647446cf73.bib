@CONFERENCE{Hou202451,
	author = {Hou, Xinying and Wu, Zihan and Wang, Xu and Ericson, Barbara J.},
	title = {CodeTailor: LLM-Powered Personalized Parsons Puzzles for Engaging Support While Learning Programming},
	year = {2024},
	journal = {L@S 2024 - Proceedings of the 11th ACM Conference on Learning @ Scale},
	pages = {51 - 62},
	doi = {10.1145/3657604.3662032},
	url = {https://www.scopus.com/pages/publications/85197053395?origin=resultslist},
	affiliations = {University of Michigan, Ann Arbor, MI, United States},
	abstract = {Learning to program can be challenging, and providing high-quality and timely support at scale is hard. Generative AI and its products, like ChatGPT, can create a solution for most intro-level programming problems. However, students might use these tools to just generate code for them, resulting in reduced engagement and limited learning. In this paper, we present CodeTailor, a system that leverages a large language model (LLM) to provide personalized help to students while still encouraging cognitive engagement. CodeTailor provides a personalized Parsons puzzle to support struggling students. In a Parsons puzzle, students place mixed-up code blocks in the correct order to solve a problem. A technical evaluation with previous incorrect student code snippets demonstrated that CodeTailor could deliver high-quality (correct, personalized, and concise) Parsons puzzles based on their incorrect code. We conducted a within-subjects study with 18 novice programmers. Participants perceived CodeTailor as more engaging than just receiving an LLM-generated solution (the baseline condition). In addition, participants applied more supported elements from the scaffolded practice to the posttest when using CodeTailor than baseline. Overall, most participants preferred using CodeTailor versus just receiving the LLM-generated code for learning. Qualitative observations and interviews also provided evidence for the benefits of CodeTailor, including thinking more about solution construction, fostering continuity in learning, promoting reflection, and boosting confidence. We suggest future design ideas to facilitate active learning opportunities with generative AI techniques. © 2024 ACM.},
	author_keywords = {active learning; generative ai; gpt; introductory programming; large language models; parsons problems; personalization},
	keywords = {Computational linguistics; Education computing; Learning systems; Active Learning; Generative ai; Gpt; High quality; Introductory programming; Language model; Large language model; Parson problem; Parsons puzzles; Personalizations; Students},
	publisher = {Association for Computing Machinery, Inc},
