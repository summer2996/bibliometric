	journal = {2025 IEEE 14th International Conference on Engineering Education: Engineering Education 5.0: Innovation, Intelligence, and Impact, ICEED 2025},
	pages = {298 - 303},
	doi = {10.1109/ICEED66794.2025.11400487},
	url = {https://www.scopus.com/pages/publications/105035999085?origin=resultslist},
	affiliations = {Universiti Sultan Zainal Abidin, Faculty of Informatics & Computing, Terengganu, Besut, Malaysia; College of Law & Management Studies, University of KwaZulu Natal, Westville, South Africa},
	abstract = {As artificial intelligence (AI) becomes increasingly embedded in education, developing students' AI literacy is essential for effective and responsible use of AI-powered tools in programming courses. This study investigates the impact of explicit AI literacy interventions on first-year undergraduate students' Object-Oriented Design (OOD) skills, problem-solving processes, and critical evaluation abilities within a computer science curriculum. Employing a mixed-methods approach, students completed a three-phase lab activity: manual OOD, AI-assisted critique and refinement using generative AI tools, and reflective analysis of their experiences. Quantitative results from rubric-based assessments reveal statistically significant improvements across all OOD dimensions, especially in students' ability to articulate design rationales and critically evaluate solutions. Thematic analysis of student reflections highlights the dual role of AI as a design aid and learning facilitator, fostering greater confidence, conceptual understanding, and metacognitive engagement. However, challenges such as prompt formulation and managing AI output complexity were also identified. These findings offer actionable insights for integrating AI literacy into programming education, supporting both conceptual and critical thinking skill development. © 2025 IEEE.},
	author_keywords = {AI literacy; generative AI; programming education},
	keywords = {Curricula; Education computing; Object oriented programming; Students; Artificial intelligence literacy; Design and problem-solving; Design skills; First year; Generative artificial intelligence; Object-oriented design; Problem solving skills; Programming course; Programming education; Undergraduate students; Problem solving},
