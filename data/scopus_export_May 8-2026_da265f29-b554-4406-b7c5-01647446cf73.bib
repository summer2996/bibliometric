@CONFERENCE{Das20253263,
	author = {Das, Rahul and Cheng, Qiong},
	title = {GraphRAG-Augmented Mastery Modeling for Student Programming Learning Trajectory Prediction and Explanation Via Fuzzy Clustering},
	year = {2025},
	journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
	pages = {3263 - 3268},
	doi = {10.1109/ICDMW69685.2025.00441},
	url = {https://www.scopus.com/pages/publications/105035389895?origin=resultslist},
	affiliations = {University of North Carolina at Charlotte, Department of Computer Science, Charlotte, NC, United States},
	abstract = {Understanding how students acquire programming and problem-solving skills over time is a central challenge in intelligent tutoring systems and educational data mining. While Knowledge Tracing (KT) is powerful at modeling students' temporal mastery progression, it is limited in capturing the relational dependencies among knowledge concepts, further subject to providing interpretable explanations of learning progression. Our GraphRAG-augmented mastery modeling addresses this limitation by incorporating graph-based representations of conceptual relationships to enhance interpretability. This paper presents an innovate framework for GraphRAG-augmented mastery modeling for student programming learning trajectory prediction and explanation via fuzzy clustering. We first extracted interpretable features that represent concept engagement and student mastery of learning outcomes from programming submissions, aligning them with structured domain knowledge retrieved and grounded via a Knowledge Graph RAG-augmented generation pipeline. We further quantified students' ability by goal-driven skill acquisition using a basic Bayesian Item Response Theory (BIRT) model. Our concept-aware and partial-credit performance factor analysis (PFA) yielded actionable insights into student learning trajectories. To reveal latent learning patterns, we apply fuzzy clustering to find patterns in the student ability changes, identifying interpretable trajectories of skill acquisition. © 2025 IEEE.},
