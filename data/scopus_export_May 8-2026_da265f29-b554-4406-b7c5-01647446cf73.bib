@ARTICLE{Van Schoors202474,
	author = {Van Schoors, Rani and Bhatt, Sohum M. and Elen, Jan and Raes, Annelies and Van den Noortgate, Wim and Depaepe, Fien},
	title = {DESIGN AND DEVELOPMENT OF A DIGITAL PERSONALIZED LEARNING TRACK: BRIDGING THE GAP BETWEEN TEXTUAL AND VISUAL PROGRAMMING},
