	keywords = {Curricula; Integration testing; Students; Teaching; Analytical reasoning; Introductory programming; Introductory programming course; Logical reasoning; Primary objective; Problem-solving; Programming course; Programming tasks; Software testings; Systematic Review; Problem solving},
