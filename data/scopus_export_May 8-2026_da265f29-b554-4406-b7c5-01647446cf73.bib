@ARTICLE{Jeon2026,
	author = {Jeon, Jaecheon and Jang, Junhyeok and Jung, Soon Ki},
	title = {Development and Classroom Evaluation of a Static-Assessment Programming Practice Platform: Scaffolding Intensity and Subsequent-Task Performance},
	year = {2026},
	journal = {IEEE Access},
	pages = {},
	doi = {10.1109/ACCESS.2026.3686194},
	url = {https://www.scopus.com/pages/publications/105036572975?origin=resultslist},
	affiliations = {Kyungpook National University, School of Computer Science and Engineering, Daegu, 41566, South Korea},
	abstract = {Programming-practice platforms for schools need feedback mechanisms that avoid executing arbitrary student code on shared servers. This paper presents Code-Assist-Lab, a web-based Python practice platform that combines abstract syntax tree (AST) checks, Radon, and Flake8 to deliver static assessment and staged scaffolding without server-side code execution. We report a small pilot classroom evaluation conducted with 20 middle-school gifted learners in a specialized winter program. Students completed the platform tasks under either a LIGHT or a STRONG bundled scaffolding policy across a four-part sequence comprising a pretest, guided tasks, immediate subsequent tasks, and a one-week delayed follow-up. The STRONG condition combined richer rule-based hints, higher help ceilings, meta-hints, and optional large-language-model (LLM) access; accordingly, the study does not isolate the effect of any single support component. Baseline pretest performance was similar across conditions. During guided tasks, STRONG showed more favorable component indicators, including higher pass rates and lower complexity and lint counts. Immediate and short-delayed subsequent-task full-pass rates were also higher in STRONG (62.5% vs. 17.5% and 40.0% vs. 5.0%, respectively), although these estimates should be interpreted cautiously given the small sample. CQI was retained only as a heuristic summary index for short beginner programs rather than as a primary proxy for overall programming ability. Within the bounds of this gifted-learner pilot and its short delayed-follow-up window, the findings suggest that a stronger bundled scaffolding policy on a static-assessment platform was associated with more favorable guided-task performance and short-delayed subsequent-task outcomes. Larger and more controlled studies are needed to test generalizability, disentangle support components, and examine longer-term retention. © 2013 IEEE.},
