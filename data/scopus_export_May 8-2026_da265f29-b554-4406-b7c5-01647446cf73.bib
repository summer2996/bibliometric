@ARTICLE{Gao2026,
	author = {Gao, Zhizezhang and Yan, Haochen and Huang, Ying and Zhang, Xiao and Saqr, Mohammed and Sun, Xia and Feng, Jun},
	title = {A complex system approach to decode different learning patterns in programming between majors: score, engagement, and problem-solving efficiency},
