	title = {Quack! Configuring Large Language Models to Serve as Rubber Duck Coding Assistants},
	year = {2025},
	journal = {SIGCSE TS 2025 - Proceedings of the 56th ACM Technical Symposium on Computer Science Education},
	volume = {2},
