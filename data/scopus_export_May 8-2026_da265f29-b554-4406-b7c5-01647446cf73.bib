@CONFERENCE{Hebbar202530,
	author = {Hebbar, Sannidhi V and Harini, Sasmita and Kumar, Viraj},
	title = {Refuting LLM-generated Code with Reactive Task Comprehension},
	year = {2025},
	journal = {Annual Conference on Innovation and Technology in Computer Science Education, ITiCSE},
	volume = {1},
	pages = {30 - 36},
	doi = {10.1145/3724363.3729100},
