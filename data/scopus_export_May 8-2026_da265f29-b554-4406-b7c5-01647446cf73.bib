	title = {The Rest of the Robots: Generative AI in Post-introductory Computing Education},
	year = {2026},
	journal = {ITiCSE-WGR 2025 - Publication of the 2025 Working Group Reports on Innovation and Technology in Computer Science Education},
	pages = {61 - 107},
	doi = {10.1145/3760545.3783970},
	url = {https://www.scopus.com/pages/publications/105031889996?origin=resultslist},
	affiliations = {United States Air Force Academy, Colorado Springs, United States; Lusofona University, Lisbon, Portugal; KTH Royal Institute of Technology, Stockholm, Sweden; Swansea University, Swansea, United Kingdom; Northumbria University, Newcastle upon Tyne, United Kingdom; JetBrains Research, Belgrade, Serbia; United States Military Academy, West Point, United States; University of Virginia, Charlottesville, United States; Universidade da Beira Interior, Covilhã, Portugal; Open Universiteit, Heerlen, Netherlands; Macquarie University, Sydney, NSW, Australia; Interdisciplinary Transformation University, Linz, Austria; Worcester Polytechnic Institute, Worcester, United States; Blekinge Institute of Technology, Karlskrona, Blekinge, Sweden; University of California, La Jolla, San Diego, United States; US Army, Department of Defense or the US Government, United States},
	abstract = {Generative AI (GenAI) is playing an increasingly influential role in computing education across all levels, offering new opportunities to support both teaching and learning. However, its effective integration raises critical concerns related to trust, academic integrity, and broader social and ethical implications. While substantial attention has been given to GenAI use in introductory programming courses (e.g., CS0/CS1), there remains a notable gap in research addressing its application in upper-level computing courses, such as software engineering, human-computer interaction, algorithms, operating systems, and theoretical computer science. This working group report presents two complementary studies: A systematic literature review of GenAI interventions in upper-level computing education, and a survey of computing instructors on their practices and perspectives regarding GenAI integration in these contexts. Based on the combined findings, this report presents an overview of current practice and practical guidance for computing instructors. The report is intended to inform the design of engaging, pedagogically sound, and forward-looking curricula that align with modern educational and workforce standards and expectations.  © 2025 Owner/Author(s).},
