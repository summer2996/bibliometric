	year = {2025},
	journal = {Proceedings of the International Joint Conference on Neural Networks},
	pages = {},
	doi = {10.1109/IJCNN64981.2025.11227611},
	url = {https://www.scopus.com/pages/publications/105023985648?origin=resultslist},
	affiliations = {Shanghai Key Laboratory of Trustworthy Computing, East China Normal University, Shanghai, China},
	abstract = {Code knowledge tracing, as a crucial component of programming education, predicts students' future performance on problems based on their prior attempts. Previous studies have not effectively leveraged information in students' attempts, including the problems, the skills required(i.e. knowledge components, KC), and the interrelations among them. To address this limitation, we propose DACKT (Dual Attention Code Knowledge Tracing), an attention-based approach that effectively captures the relationship between student knowledge components and code, as well as the correlations between different problems and submissions in the students' problem-solving sequences, thus better modeling the students' knowledge levels. Specifically, we first utilize large language models (LLMs) and a pre-trained model to generate representations of programming problems. Meanwhile, we apply code embedding techniques to represent students' code. Then, we employ an attention mechanism to use the knowledge component information of the problems as query vectors to identify the parts of the code features most relevant to the knowledge components, leading to more effective representations of the code. Finally, we utilize a custom sequence attention mechanism to integrate the learned code representations and problem representations, resulting in significant improvements over baseline models. © 2025 IEEE.},
	author_keywords = {Attention; Code Knowledge Tracing; Code Representation; LLM},
