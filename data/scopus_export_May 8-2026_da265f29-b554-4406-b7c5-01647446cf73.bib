	url = {https://www.scopus.com/pages/publications/105003729135?origin=resultslist},
	affiliations = {Department of Informatics, University of Salerno, SA, Fisciano, Italy},
	abstract = {The improved capabilities of Large Language Models (LLMs) enable their use in various fields, including education. Teachers and students already use LLMs to support teaching and learning. In this study, we measure the accuracy of LLMs gpt-3.5, gpt-4o, claude-sonnet-20241022, and llama3 in correcting and evaluating students' programming assignments. Seven assessments carried out by 50 students were assessed using three different prompting strategies for each of the LLMs presented. Then we compared the generated grades with the grades assigned by the teacher, who corrected them manually throughout the year. The results showed that models such as llama3 and gpt-4o obtained low percentages of generated evaluations, while gpt-3.5 and claude-sonnet-20241022 obtained interesting results if they received at least one example of evaluation. Copyright © 2025 by SCITEPRESS - Science and Technology Publications, Lda.},
	author_keywords = {Automatic Code Evaluation; Large Language Models; Programming Education},
	keywords = {Automatic programming; High level languages; Report generators; Teaching; Automatic code evaluation; Automatic codes; Code evaluation; Language model; Large language model; Programming assignments; Programming education; Teachers'; Teaching and learning; Students},
