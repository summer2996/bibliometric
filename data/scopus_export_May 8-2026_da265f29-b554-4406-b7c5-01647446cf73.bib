@CONFERENCE{Omri2025414,
	author = {Omri, Aymen and Bouallegue, Seifeddine and Feki, Ayoub and Ford, Robert and Ciftler, Bekir Sait and Shikfa, Abdullatif and Khan, Shiban and Al-Naemi, Salem},
	title = {Early Student Performance Prediction in Personalized Programming Education},
	year = {2025},
	journal = {Proceedings of the 2025 17th International Conference on Education Technology and Computers, ICETC 2025},
	pages = {414 - 421},
	doi = {10.1109/ICETC66579.2025.11387617},
	url = {https://www.scopus.com/pages/publications/105035213680?origin=resultslist},
	affiliations = {University of Doha for Science and Technology, Dept. of Software Systems, Doha, Qatar; University of Doha for Science and Technology, Dept. of Data Science and AI, Doha, Qatar; University of Doha for Science and Technology, Dept. of Cybersecurity, Doha, Qatar; University of Doha for Science and Technology, Dept. of Management, Doha, Qatar; University of Doha for Science and Technology, College of Computing and IT, Doha, Qatar},
	abstract = {Intelligent recommender systems play a key role in identifying at-risk students and personalizing learning with tailored resources. Accurate prediction of student achievement is crucial for enabling these systems to deliver timely interventions and offer data-driven support. This paper presents the application of machine learning models to predict final exam grades in a university-level programming course. It investigates the use of multi-modal student data to enhance prediction accuracy. In particular, a recent raw dataset of students enrolled in a programming course across ten different class sections, collected one month prior to the final exam, was initially processed. From this data, a comprehensive set of features was engineered, including assessment grades and completion durations, digital learning interactions, and engagement metrics. These features were then used to train and evaluate six machine learning prediction models, where Random Forest has achieved the highest predictive accuracy (above 90%). Feature importance analysis has revealed that the midterm grade and the average completion duration of lab assessments are the most influential predictors. The results highlight the significant potential of early grade prediction as a practical and efficient tool for programming educational recommender systems. This data-driven approach allows instructors to identify and support atrisk students, paving the way for adaptive learning environments that offer personalized feedback, targeted resources, and timely interventions. Ultimately, such systems promote deeper student engagement, enhance academic performance, and improve retention rates within computing disciplines. © 2025 IEEE.},
