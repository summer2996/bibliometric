@CONFERENCE{Miller20211048,
	author = {Miller, Craig S. and Settle, Amber},
	title = {Mixing and Matching Loop Strategies: By Value or by Index?},
	year = {2021},
	journal = {SIGCSE 2021 - Proceedings of the 52nd ACM Technical Symposium on Computer Science Education},
	pages = {1048 - 1054},
	doi = {10.1145/3408877.3432368},
	url = {https://www.scopus.com/pages/publications/85103332562?origin=resultslist},
	affiliations = {DePaul University, Chicago, IL, United States},
	abstract = {Increasingly, languages used in computing curricula offer abstract constructs that permit list iteration by value, in addition to the traditional access by index. Given this option, this study explores the loop constructs students choose when solving a problem. We asked students from introductory programming courses to write solutions to two tasks that require iteration through array or list objects, analyzing their responses and noting coding constructs that indicate a loop-by-value strategy or a loop-by-index strategy. Consistent with previous accounts, we find that students may employ a strategy based on their experience and the required task. However, they often implement the strategy using code elements that are inconsistent with the chosen strategy, including referencing the index when a reference to the value at the location of the index is required. Some inconsistencies, such as the use of misleading variable names, do not affect program execution but often coincide with other inconsistencies that produce incorrect code. We recommend that instructors provide explicit scaffolding for the sequential introduction of iterative constructs. We note that a discussion of when each type of loop is typically used may be insufficient and suggest reinforcing habits for maintaining and checking consistency of looping strategies. © 2021 ACM.},
	author_keywords = {abstraction; array references; looping strategies; problem solving},
	keywords = {Education computing; Scaffolds; Abstraction; Array references; Computing curricula; Introductory programming course; Looping strategy; Matchings; Problem-solving; Program execution; Value strategies; Students},
