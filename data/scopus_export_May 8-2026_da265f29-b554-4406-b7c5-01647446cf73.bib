@CONFERENCE{Wang202511,
	author = {Wang, Xuan and Zhang, Liyin and Ouyang, Fan},
	title = {The Effects of Self-regulated Scaffolds and Learning Examples on Computer Programming},
	year = {2025},
	journal = {2025 7th International Conference on Computer Science and Technologies in Education, CSTE 2025},
	pages = {11 - 15},
	doi = {10.1109/CSTE64638.2025.11092065},
	url = {https://www.scopus.com/pages/publications/105013538538?origin=resultslist},
	affiliations = {Zhejiang University, College of Education, Hangzhou, China},
	abstract = {The status of programming education in our country's educational system has become increasingly prominent. However, constrained by large class sizes, limited class hours, and diverse student needs, exploring high-quality programming teaching strategies has become an urgent priority. Existing research has demonstrated that self-regulated learning scaffolds and learning examples are two powerful tools that can facilitate students' learning. In teaching practice, these two tools are often used together to enhance comprehension and engagement. However, there is a lack of studies proving the effectiveness of their combined use. To address this gap, the present study employed a 2×2 experimental design to compare the impact of combining self-regulated learning scaffolds with different types of learning examples on students' programming learning outcomes. The findings reveal that: (1) When using self-regulated learning scaffolds, worked examples are more effective for students' programming learning; (2) Without the use of self-regulated learning scaffolds, erroneous examples are more beneficial for students' programming learning; (3) The combination of self-regulated learning scaffolds and worked examples can promote students to develop richer, more adaptive learning strategies, significantly improving overall learning efficiency. © 2025 IEEE.},
	author_keywords = {Erroneous examples; Programming education; Self-Regulated Learning(SRL); SRL Scaffolds; Worked examples},
	keywords = {Computer software; Computer systems programming; Education computing; Learning systems; Scaffolds; Teaching; Class size; Educational systems; Erroneous example; Learning scaffolds; Programming education; Programming learning; Self-regulated learning; Self-regulated learning scaffold; Worked examples; Students},
	correspondence_address = {F. Ouyang; Zhejiang University, College of Education, Hangzhou, China; email: fanouyang@zju.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
